---
import releases from '../data/releases.json';
import config from '../data/config.json';
---

<section class="hero-section" aria-label="Product Introduction">
  <div class="container hero-container">
    <!-- Hero Copy -->
    <div class="hero-copy">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Version {releases.windows.version} for Windows • {releases.android.version} for Android</span>
      </div>

      <h1 class="hero-title">
        Your library.<br/>
        <span class="text-gradient">A little more at home.</span>
      </h1>

      <p class="hero-subtitle">
        Meet Lirune — a calm, private reading experience for your digital books and documents, built for Windows and Android. No accounts, no cloud sync, zero telemetry, and 19 universal formats supported natively.
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <!-- Windows Store / Download -->
        <a href="/downloads#windows" class="btn btn-windows btn-lg hero-btn">
          <svg width="20" height="20" viewBox="0 0 88 88" fill="currentColor" aria-hidden="true">
            <path d="M0 12.402l35.689-4.86.016 34.423-35.67.203zm35.67 33.529l.026 34.453-35.67-4.887-.026-29.566zm4.326-39.043L87.914 0v41.525l-47.918.278zm47.918 48.749L39.996 88V46.541l47.918.257z"/>
          </svg>
          <div class="btn-text-wrap">
            <span class="btn-subtext">Download for</span>
            <span class="btn-maintext">Windows 10/11</span>
          </div>
        </a>

        <!-- Android APK -->
        <a href="/downloads#android" class="btn btn-android btn-lg hero-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.1 12 8.1s-3.5902.3116-5.1367.8497L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
          </svg>
          <div class="btn-text-wrap">
            <span class="btn-subtext">Get APK for</span>
            <span class="btn-maintext">Android v{releases.android.version}</span>
          </div>
        </a>

        <!-- Explore Features secondary -->
        <a href="/features" class="btn btn-secondary btn-lg">
          Explore Features
        </a>
      </div>

      <!-- Trust Row -->
      <div class="hero-trust-row">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>100% Offline & Private</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>
          <span>19 File Formats</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
          <span>No Account Required</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trust-icon" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>GPL-3.0 Open Source</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual Preview -->
    <div class="hero-visual">
      <div class="device-desktop-frame">
        <div class="device-desktop-header">
          <div class="device-desktop-dots">
            <span class="device-dot"></span>
            <span class="device-dot"></span>
            <span class="device-dot"></span>
          </div>
          <span class="device-desktop-title">Lirune Reader — Library</span>
        </div>
        <img
          src="/images/screenshots/win-library-grid.png"
          alt="Lirune Reader Windows desktop application running in default dark theme with personal library grid"
          width="1280"
          height="800"
          loading="eager"
          decoding="async"
          class="hero-screenshot"
        />
      </div>

      <!-- Overlaid Android Phone Mockup (showing dual platform) -->
      <div class="hero-phone-overlay">
        <div class="device-phone-frame">
          <div class="device-phone-notch"></div>
          <img
            src="/images/screenshots/android-reader-epub.png"
            alt="Lirune Reader Android app showing continuous scroll reading view"
            width="320"
            height="693"
            loading="eager"
            decoding="async"
            class="phone-screenshot"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-16);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-10);
  }

  .hero-copy {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: var(--sp-6);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-success);
    box-shadow: 0 0 8px var(--status-success);
  }

  .hero-title {
    margin-bottom: var(--sp-6);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 720px;
    margin-bottom: var(--sp-8);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-bottom: var(--sp-10);
  }

  .hero-btn {
    text-align: left;
    padding: 12px 22px;
  }

  .btn-text-wrap {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .btn-subtext {
    font-size: 0.75rem;
    opacity: 0.85;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .btn-maintext {
    font-size: 1rem;
    font-weight: 700;
  }

  .hero-trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-8);
    flex-wrap: wrap;
    color: var(--text-tertiary);
    font-size: 0.92rem;
    font-weight: 550;
    padding-top: var(--sp-4);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .trust-icon {
    color: var(--accent-chrome);
  }

  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 1040px;
    margin-top: var(--sp-4);
  }

  .hero-screenshot {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .hero-phone-overlay {
    position: absolute;
    right: -24px;
    bottom: -32px;
    width: 220px;
    z-index: 5;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.8));
    animation: floatPhone 6s ease-in-out infinite;
  }

  @keyframes floatPhone {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-phone-overlay {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero-phone-overlay {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-subtitle {
      font-size: 1.1rem;
    }
    .hero-trust-row {
      gap: var(--sp-4);
      font-size: 0.82rem;
    }
  }
</style>
