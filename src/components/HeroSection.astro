---
import releases from '../data/releases.json';
import config from '../data/config.json';
---

<section class="hero-section" aria-label="Lirune Reader Introduction">
  <div class="site-container hero-container">
    <!-- Hero Copy Column -->
    <div class="hero-copy">
      <!-- Release Status Badge -->
      <div class="hero-badge-strip">
        <span class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Windows 6.0.0 | Android 5.0.0 — Now available</span>
        </span>
        <span class="hero-badge hero-badge-secondary">GPL-3.0 Open Source</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        Lirune — 50+ formats. One reader. Every document. Your privacy.
      </h1>

      <!-- Sub-headline -->
      <p class="hero-subtitle">
        A calm, distraction-free reading experience for your digital books, comics, and documents on <strong>Windows</strong> and <strong>Android</strong>. 100% offline with zero cloud tracking, local storage, and true digital ownership.
      </p>

      <!-- Primary Action CTAs -->
      <div class="hero-actions">
        <a href="/downloads" class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Free</span>
        </a>

        <a href="/formats" class="btn btn-secondary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
          <span>Explore Formats</span>
        </a>

        <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-subtle btn-lg" aria-label="Get Lirune on the Microsoft Store">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
          </svg>
          <span>Microsoft Store ↗</span>
        </a>
      </div>

      <!-- Social Proof Strip -->
      <div class="hero-proof-strip">
        <div class="proof-pill">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="proof-icon" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>50+ document formats. Zero cloud. 100% local.</span>
        </div>
      </div>

      <!-- Platform Details Metadata Strip -->
      <div class="hero-meta-strip">
        <div class="hero-meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="meta-check" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Windows 6.0.0 (Store & Installer)</span>
        </div>
        <div class="hero-meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="meta-check" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Android 5.0.0 (Zero-network APK)</span>
        </div>
        <div class="hero-meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="meta-check" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>No Account Required</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual Showcase -->
    <div class="hero-showcase">
      <!-- Windows Desktop Mockup -->
      <div class="device-frame-desktop hero-desktop-frame" data-reveal>
        <div class="device-header-desktop">
          <div class="device-dots">
            <span class="device-dot"></span>
            <span class="device-dot"></span>
            <span class="device-dot"></span>
          </div>
          <span class="device-title">Lirune Reader — Windows 11</span>
          <span class="device-status-badge">v6.0.0</span>
        </div>
        <div class="device-content">
          <img
            src="/images/screenshots/win-library-grid.png"
            alt="Lirune Reader Windows desktop application showcasing digital book library grid in obsidian dark theme"
            width="1280"
            height="800"
            class="device-img"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Floating Android Mobile Mockup -->
      <div class="device-frame-mobile hero-mobile-frame" data-reveal>
        <div class="device-notch-mobile"></div>
        <div class="device-content">
          <img
            src="/images/screenshots/android-reader-epub.png"
            alt="Lirune Reader for Android running Scroll Engine v2 with refined book typography"
            width="400"
            height="820"
            class="device-img"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(48px, 6vw, 84px);
    padding-bottom: clamp(64px, 8vw, 112px);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
    align-items: center;
  }

  .hero-copy {
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge-strip {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--r-full);
    background-color: var(--accent-chrome-subtle);
    color: var(--accent-chrome);
    border: 1px solid var(--border-accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero-badge-secondary {
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    border-color: var(--border-default);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--status-success);
    box-shadow: 0 0 10px var(--status-success);
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-4);
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.28rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 740px;
    margin-bottom: var(--sp-6);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-5);
  }

  .btn-lg {
    padding: 14px 26px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--r-md);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform var(--t-fast), box-shadow var(--t-fast), background-color var(--t-fast);
  }

  .btn-lg:hover {
    transform: translateY(-2px);
  }

  .hero-proof-strip {
    margin-bottom: var(--sp-6);
  }

  .proof-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: var(--r-full);
    background-color: var(--bg-card);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    font-size: 0.92rem;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  .proof-icon {
    color: var(--status-success);
    flex-shrink: 0;
  }

  .hero-meta-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 32px);
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-tertiary);
  }

  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-check {
    color: var(--status-success);
  }

  /* Hero Showcase Visual */
  .hero-showcase {
    position: relative;
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    margin-top: var(--sp-2);
  }

  .hero-desktop-frame {
    width: 100%;
    border-radius: var(--r-lg);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .device-header-desktop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background-color: var(--bg-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .device-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .device-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .device-title {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .device-status-badge {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--accent-chrome);
    padding: 2px 6px;
    border-radius: var(--r-xs);
    background-color: var(--accent-chrome-subtle);
  }

  .device-content {
    line-height: 0;
    overflow: hidden;
  }

  .device-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hero-mobile-frame {
    position: absolute;
    bottom: -36px;
    right: 28px;
    width: clamp(190px, 24vw, 270px);
    border-radius: var(--r-2xl);
    background-color: var(--bg-surface);
    border: 2px solid var(--border-strong);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    z-index: 10;
    transition: transform var(--t-normal);
  }

  .hero-mobile-frame:hover {
    transform: translateY(-6px);
  }

  .device-notch-mobile {
    width: 80px;
    height: 14px;
    background-color: var(--bg-base);
    border-radius: 0 0 10px 10px;
    margin: 0 auto;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 12;
  }

  @media (max-width: 680px) {
    .hero-mobile-frame {
      display: none;
    }
  }
</style>
