---
// Component: DownloaderAnnouncement.astro
// Announcing Lirune Downloader — A New Lirune Experience
---

<section class="downloader-section section-spacing" id="downloader" aria-label="Lirune Downloader Announcement">
  <div class="site-container">
    <div class="downloader-card surface-card" data-reveal>
      <!-- Atmospheric decorative glow -->
      <div class="card-glow" aria-hidden="true"></div>

      <div class="downloader-layout">
        <!-- Visual Brand Artwork Column -->
        <div class="artwork-column">
          <div class="icon-stage">
            <div class="icon-ambient-glow" aria-hidden="true"></div>
            <img
              src="/images/branding/lirune-downloader-icon.svg"
              alt="Lirune Downloader app icon"
              width="180"
              height="180"
              class="downloader-hero-icon"
              loading="lazy"
            />
            <span class="status-pill">
              <span class="status-pulse-dot" aria-hidden="true"></span>
              COMING SOON
            </span>
          </div>
        </div>

        <!-- Editorial Content Column -->
        <div class="content-column">
          <!-- Eyebrow Badge -->
          <div class="eyebrow-wrapper">
            <span class="badge badge-accent">A NEW LIRUNE EXPERIENCE &middot; COMING SOON</span>
          </div>

          <!-- Headings -->
          <h2 class="main-heading">Something exciting is on its way.</h2>
          <h3 class="product-heading">Meet <span class="highlight-text">Lirune Downloader</span>.</h3>

          <!-- Main & Supporting Descriptions -->
          <p class="main-desc">
            Your next favourite way to download is getting ready.
          </p>
          <p class="supporting-desc">
            A fresh, beautifully simple downloading experience for Windows and Android. Completely free, with no ads, no subscriptions and no unnecessary complications.
          </p>

          <!-- Feature Highlights Grid -->
          <ul class="feature-highlights" role="list">
            <li class="feature-item">
              <span class="feature-bullet" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>Completely free.</span>
            </li>
            <li class="feature-item">
              <span class="feature-bullet" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>No advertisements.</span>
            </li>
            <li class="feature-item">
              <span class="feature-bullet" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>No subscriptions.</span>
            </li>
            <li class="feature-item">
              <span class="feature-bullet" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>Designed for Windows and Android.</span>
            </li>
            <li class="feature-item">
              <span class="feature-bullet" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>A simple, focused downloading experience.</span>
            </li>
          </ul>

          <!-- Closing Callout -->
          <div class="closing-callout">
            <p class="closing-lead">Less hassle. More downloading.</p>
            <p class="closing-sub">
              We're putting the finishing touches on something we've been excited to build. Stay tuned!
            </p>
          </div>

          <!-- Provenance and Attribution -->
          <footer class="attribution-footer">
            <span>Created by <strong>Vasanth Gajavelly</strong>.</span>
            <span class="attribution-sep" aria-hidden="true">&bull;</span>
            <span>Part of the <strong>Lirune</strong> software family.</span>
          </footer>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .downloader-section {
    position: relative;
  }

  .downloader-card {
    background: linear-gradient(145deg, #091426 0%, #10243b 50%, #0d1b2a 100%);
    border: 1px solid rgba(98, 210, 232, 0.22);
    border-radius: var(--r-xl);
    padding: clamp(32px, 5vw, 56px);
    position: relative;
    overflow: hidden;
    box-shadow: 0 24px 64px -12px rgba(9, 20, 38, 0.45);
  }

  .card-glow {
    position: absolute;
    top: -120px;
    right: -120px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .downloader-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 860px) {
    .downloader-layout {
      grid-template-columns: 1fr;
      text-align: left;
    }
  }

  /* Artwork / Icon Stage */
  .artwork-column {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .icon-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .icon-ambient-glow {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.22) 0%, rgba(2, 132, 199, 0.08) 50%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    filter: blur(14px);
    pointer-events: none;
  }

  .downloader-hero-icon {
    position: relative;
    z-index: 2;
    border-radius: 36px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(154, 246, 244, 0.25);
    transition: transform var(--t-normal) ease;
  }

  .downloader-hero-icon:hover {
    transform: translateY(-4px) scale(1.02);
  }

  .status-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background-color: rgba(154, 246, 244, 0.1);
    border: 1px solid rgba(154, 246, 244, 0.35);
    color: #9af6f4;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00f0ff;
    box-shadow: 0 0 8px #00f0ff;
    animation: status-pulse 2s infinite ease-in-out;
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }

  /* Content Column */
  .content-column {
    display: flex;
    flex-direction: column;
  }

  .eyebrow-wrapper {
    margin-bottom: var(--sp-3);
  }

  .main-heading {
    font-size: clamp(1.85rem, 3.4vw, 2.5rem);
    line-height: 1.18;
    color: #ffffff;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-2);
  }

  .product-heading {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.25;
    color: #e2e8f0;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-4);
  }

  .highlight-text {
    background: linear-gradient(120deg, #9af6f4 0%, #62d2e8 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
  }

  .main-desc {
    font-size: 1.18rem;
    line-height: 1.5;
    color: #ffffff;
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }

  .supporting-desc {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin-bottom: var(--sp-6);
    max-width: 62ch;
  }

  /* Feature Highlights */
  .feature-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-6) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 10px 16px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    color: #f1f5f9;
    font-weight: 500;
  }

  .feature-bullet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: rgba(0, 240, 255, 0.15);
    color: #00f0ff;
    flex-shrink: 0;
  }

  /* Closing Callout */
  .closing-callout {
    background: rgba(16, 36, 59, 0.7);
    border: 1px solid rgba(98, 210, 232, 0.2);
    border-radius: var(--r-md);
    padding: 14px 18px;
    margin-bottom: var(--sp-5);
  }

  .closing-lead {
    font-size: 1.02rem;
    font-weight: 700;
    color: #62d2e8;
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }

  .closing-sub {
    font-size: 0.92rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
  }

  /* Footer Attribution */
  .attribution-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: var(--sp-3);
  }

  .attribution-footer strong {
    color: #e2e8f0;
  }

  .attribution-sep {
    color: #475569;
  }

  @media (prefers-reduced-motion: reduce) {
    .status-pulse-dot {
      animation: none;
    }
    .downloader-hero-icon {
      transition: none;
    }
    .downloader-hero-icon:hover {
      transform: none;
    }
  }
</style>
