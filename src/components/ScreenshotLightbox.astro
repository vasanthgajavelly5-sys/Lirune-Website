---
// Screenshot Lightbox Modal Component
---

<div id="screenshot-lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Screenshot zoom viewer">
  <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
  <div class="lightbox-container">
    <button class="lightbox-close-btn" id="lightbox-close-btn" aria-label="Close image viewer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" alt="" class="lightbox-image" />
      <div class="lightbox-caption">
        <h3 id="lightbox-title" class="lightbox-title"></h3>
        <p id="lightbox-desc" class="lightbox-desc"></p>
      </div>
    </div>
  </div>
</div>

<script>
  const lightbox = document.getElementById('screenshot-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const closeBtn = document.getElementById('lightbox-close-btn');
  const backdrop = document.getElementById('lightbox-backdrop');

  function openLightbox(src, title, caption) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.setAttribute('src', src);
    lightboxImg.setAttribute('alt', title || 'Screenshot');
    if (lightboxTitle) lightboxTitle.textContent = title || '';
    if (lightboxDesc) lightboxDesc.textContent = caption || '';

    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-locked');
    closeBtn?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-locked');
  }

  // Attach to all elements with class .clickable-shot
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.clickable-shot');
    if (target) {
      const src = target.getAttribute('data-full');
      const title = target.getAttribute('data-title');
      const caption = target.getAttribute('data-caption');
      if (src) openLightbox(src, title, caption);
    }
  });

  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) {
      closeLightbox();
    }
  });
</script>

<style>
  .lightbox-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .lightbox-modal.is-open {
    display: flex;
    opacity: 1;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(8, 10, 14, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-container {
    position: relative;
    z-index: 2;
    max-width: min(1200px, 94vw);
    max-height: 94vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-close-btn {
    position: absolute;
    top: -48px;
    right: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .lightbox-close-btn:hover {
    background: var(--accent);
    color: var(--text-on-accent);
    transform: scale(1.08);
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
    max-height: 85vh;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 72vh;
    object-fit: contain;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border-strong);
  }

  .lightbox-caption {
    text-align: center;
    max-width: 700px;
  }

  .lightbox-title {
    font-size: 1.15rem;
    font-weight: 650;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .lightbox-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
</style>
