---
import allFaqs from '../data/faq.json';

interface Props {
  limit?: number;
  showAllLink?: boolean;
}

const { limit, showAllLink = false } = Astro.props;
const faqs = limit ? allFaqs.slice(0, limit) : allFaqs;
---

<div class="faq-accordion-component" aria-label="Frequently Asked Questions Accordion">
  <div class="faq-list">
    {faqs.map((item, idx) => {
      const q = item.q || item.question;
      const a = item.a || item.answer;
      return (
        <details class="faq-item surface-card" open={idx === 0}>
          <summary class="faq-question" role="button" aria-expanded={idx === 0 ? "true" : "false"}>
            <span class="q-text">{q}</span>
            <span class="faq-arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{a}</p>
          </div>
        </details>
      );
    })}
  </div>

  {showAllLink && (
    <div class="faq-footer-link text-center">
      <a href="/faq" class="btn btn-secondary">
        <span>View all frequently asked questions →</span>
      </a>
    </div>
  )}
</div>

<script>
  // Ensure aria-expanded stays synchronized with <details> open states for accessibility
  function setupFaqAccordion() {
    document.querySelectorAll<HTMLDetailsElement>('.faq-accordion-component .faq-item').forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.faq-question');
      if (!summary) return;

      details.addEventListener('toggle', () => {
        summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
      });
    });
  }

  document.addEventListener('astro:page-load', setupFaqAccordion);
</script>

<style>
  .faq-accordion-component {
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .faq-item {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    overflow: hidden;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }

  .faq-item[open] {
    border-color: var(--border-accent);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-6);
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-text {
    flex: 1;
    text-align: left;
  }

  .faq-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-tertiary);
    transition: transform var(--t-normal), color var(--t-fast);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-answer {
    padding: 0 var(--sp-6) var(--sp-6) var(--sp-6);
    color: var(--text-secondary);
    line-height: 1.65;
    font-size: 1rem;
  }

  .faq-answer p {
    margin: 0;
  }

  .faq-footer-link {
    margin-top: var(--sp-8);
  }

  .text-center {
    text-align: center;
  }
</style>
