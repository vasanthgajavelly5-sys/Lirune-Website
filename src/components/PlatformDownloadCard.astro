---
import releases from '../data/releases.json';
import config from '../data/config.json';
---

<section class="download-cards-section" id="downloads-overview" aria-label="Dual-Platform Downloads">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-label">Official Releases</span>
      <h2 class="section-title">Built specifically for your device</h2>
      <p class="section-subtitle mx-auto">
        Download Lirune Reader directly for Windows or Android. Both platforms maintain independent release cycles and operate with zero cloud dependencies.
      </p>
    </div>

    <div class="platform-cards-grid">
      <!-- Windows Card -->
      <div class="card platform-card" id="windows">
        <div class="platform-header">
          <div class="platform-icon-wrap windows-brand">
            <svg width="28" height="28" viewBox="0 0 88 88" fill="currentColor" aria-hidden="true">
              <path d="M0 12.402l35.689-4.86.016 34.423-35.67.203zm35.67 33.529l.026 34.453-35.67-4.887-.026-29.566zm4.326-39.043L87.914 0v41.525l-47.918.278zm47.918 48.749L39.996 88V46.541l47.918.257z"/>
            </svg>
          </div>
          <div class="platform-info">
            <h3 class="platform-title">Lirune for Windows</h3>
            <span class="platform-meta">Latest Stable: <strong>v{releases.windows.version}</strong> • {releases.windows.releaseDate}</span>
          </div>
        </div>

        <p class="platform-desc">
          High-performance desktop reader with dual-page spreads, continuous scroll, integrated PDF.js, and offline backup tools.
        </p>

        <!-- Windows Actions -->
        <div class="platform-actions">
          <!-- Microsoft Store (Recommended) -->
          <a
            href={releases.windows.storeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-windows btn-lg action-btn-full"
            aria-label="Install Lirune Reader from Microsoft Store"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zm-9 9h7v7H4v-7zm9 0h7v7h-7v-7z"/>
            </svg>
            Microsoft Store (Official)
          </a>

          <!-- Direct Setup.exe -->
          <a
            href={releases.windows.installerUrl}
            class="btn btn-secondary action-btn-full"
            aria-label="Download standalone Windows Setup EXE"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Direct Installer (.exe)
          </a>
        </div>

        <!-- Windows Specs & Verification -->
        <div class="platform-specs">
          <div class="spec-row">
            <span class="spec-label">Requirements:</span>
            <span class="spec-val">{releases.windows.requirements}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Store ID:</span>
            <span class="spec-val"><code>{releases.windows.storeId}</code></span>
          </div>
          <div class="spec-row">
            <span class="spec-label">SHA-256:</span>
            <span class="spec-val hash-val" title={releases.windows.sha256}>
              <code>{releases.windows.sha256.slice(0, 16)}...{releases.windows.sha256.slice(-8)}</code>
            </span>
          </div>
        </div>

        <div class="platform-footer-link">
          <a href="/downloads#windows" class="link-subtle">
            Full Windows installation & verification instructions →
          </a>
        </div>
      </div>

      <!-- Android Card -->
      <div class="card platform-card" id="android">
        <div class="platform-header">
          <div class="platform-icon-wrap android-brand">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.1 12 8.1s-3.5902.3116-5.1367.8497L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
            </svg>
          </div>
          <div class="platform-info">
            <h3 class="platform-title">Lirune for Android</h3>
            <span class="platform-meta">Latest Stable: <strong>v{releases.android.version}</strong> • {releases.android.releaseDate}</span>
          </div>
        </div>

        <p class="platform-desc">
          Smooth 60fps virtualized Scroll Engine v2, local SQLite storage, SAF folder browsing, and zero network permissions.
        </p>

        <!-- Android Actions -->
        <div class="platform-actions">
          <!-- Download APK -->
          <a
            href={releases.android.apkUrl}
            class="btn btn-android btn-lg action-btn-full"
            aria-label="Download Lirune Reader Android APK"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Download APK (v{releases.android.version})
          </a>

          <!-- GitHub Release Notes -->
          <a
            href={releases.android.releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary action-btn-full"
            aria-label="View Android release notes on GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            Android Release Notes
          </a>
        </div>

        <!-- Android Specs & Verification -->
        <div class="platform-specs">
          <div class="spec-row">
            <span class="spec-label">Requirements:</span>
            <span class="spec-val">{releases.android.requirements}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Permissions:</span>
            <span class="spec-val">Zero network (`android.permission.INTERNET` removed)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">SHA-256:</span>
            <span class="spec-val hash-val" title={releases.android.sha256}>
              <code>{releases.android.sha256.slice(0, 16)}...{releases.android.sha256.slice(-8)}</code>
            </span>
          </div>
        </div>

        <div class="platform-footer-link">
          <a href="/downloads#android" class="link-subtle">
            Full Android sideloading & SHA-256 verification instructions →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .download-cards-section {
    background: #0E1218;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .platform-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--sp-8);
    margin-top: var(--sp-10);
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-8);
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }

  .platform-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .windows-brand {
    background: rgba(0, 120, 215, 0.15);
    color: #0078D7;
    border: 1px solid rgba(0, 120, 215, 0.3);
  }

  .android-brand {
    background: rgba(46, 125, 50, 0.15);
    color: #3DDC84;
    border: 1px solid rgba(46, 125, 50, 0.3);
  }

  .platform-title {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .platform-meta {
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  .platform-meta strong {
    color: var(--text-primary);
  }

  .platform-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: var(--sp-6);
    flex-grow: 1;
  }

  .platform-actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  .action-btn-full {
    width: 100%;
  }

  .platform-specs {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    font-size: 0.85rem;
    margin-bottom: var(--sp-4);
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .spec-label {
    color: var(--text-tertiary);
  }

  .spec-val {
    color: var(--text-secondary);
    text-align: right;
  }

  .hash-val code {
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: var(--r-xs);
    font-size: 0.78rem;
    color: var(--accent-chrome);
  }

  .link-subtle {
    font-size: 0.85rem;
    color: var(--accent-chrome);
    font-weight: 550;
  }

  .link-subtle:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .platform-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
