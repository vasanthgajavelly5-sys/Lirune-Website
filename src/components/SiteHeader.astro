---
import config from '../data/config.json';

const pathname = new URL(Astro.request.url).pathname;
const isCurrent = (path: string) => {
  if (path === '/' && pathname === '/') return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand" aria-label="Lirune Reader Home">
      <img src="/images/branding/lirune-icon.png" alt="Lirune Reader" width="32" height="32" class="brand-icon" />
      <span class="brand-text">Lirune</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li><a href="/" class={isCurrent('/') ? 'nav-link active' : 'nav-link'}>Home</a></li>
        <li><a href="/features" class={isCurrent('/features') ? 'nav-link active' : 'nav-link'}>Features</a></li>
        <li><a href="/formats" class={isCurrent('/formats') ? 'nav-link active' : 'nav-link'}>Formats</a></li>
        <li><a href="/screenshots" class={isCurrent('/screenshots') ? 'nav-link active' : 'nav-link'}>Screenshots</a></li>
        <li><a href="/downloads" class={isCurrent('/downloads') ? 'nav-link active' : 'nav-link'}>Downloads</a></li>
        <li><a href="/changelog" class={isCurrent('/changelog') ? 'nav-link active' : 'nav-link'}>What's New</a></li>
        <li><a href="/faq" class={isCurrent('/faq') ? 'nav-link active' : 'nav-link'}>FAQ</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Buy Me a Coffee button -->
      <a
        href={config.buyMeACoffeeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="header-action-btn coffee-action"
        title="Support Lirune Reader on Buy Me a Coffee"
        aria-label="Buy Me a Coffee"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3v2M14 3v2M5 8h14l-1.2 10.1A3.3 3.3 0 0 1 14.5 21h-5a3.3 3.3 0 0 1-3.3-2.9L5 8Z"/>
          <path d="M19 10h1a2 2 0 0 1 0 4h-1M8 11v4M12 11v4M16 11v4"/>
        </svg>
      </a>

      <!-- GitHub Icon Link -->
      <a
        href={config.githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="header-action-btn github-action"
        title="View Lirune source code on GitHub"
        aria-label="GitHub Repository"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>

      <!-- Primary Download CTA -->
      <a href="/downloads" class="btn btn-primary btn-sm header-download-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Download
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        class="mobile-nav-toggle"
        id="mobile-nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-nav-inner">
      <ul class="mobile-nav-list">
        <li><a href="/" class={isCurrent('/') ? 'mobile-link active' : 'mobile-link'}>Home</a></li>
        <li><a href="/features" class={isCurrent('/features') ? 'mobile-link active' : 'mobile-link'}>Features</a></li>
        <li><a href="/formats" class={isCurrent('/formats') ? 'mobile-link active' : 'mobile-link'}>Supported Formats</a></li>
        <li><a href="/screenshots" class={isCurrent('/screenshots') ? 'mobile-link active' : 'mobile-link'}>Live Screenshots</a></li>
        <li><a href="/downloads" class={isCurrent('/downloads') ? 'mobile-link active' : 'mobile-link'}>Downloads</a></li>
        <li><a href="/changelog" class={isCurrent('/changelog') ? 'mobile-link active' : 'mobile-link'}>What's New</a></li>
        <li><a href="/getting-started" class={isCurrent('/getting-started') ? 'mobile-link active' : 'mobile-link'}>Getting Started</a></li>
        <li><a href="/faq" class={isCurrent('/faq') ? 'mobile-link active' : 'mobile-link'}>FAQ</a></li>
        <li><a href="/privacy" class={isCurrent('/privacy') ? 'mobile-link active' : 'mobile-link'}>Privacy Architecture</a></li>
        <li><a href="/licenses" class={isCurrent('/licenses') ? 'mobile-link active' : 'mobile-link'}>Open Source & Licenses</a></li>
        <li><a href="/support" class={isCurrent('/support') ? 'mobile-link active' : 'mobile-link'}>Support & Buy Me a Coffee</a></li>
      </ul>
      <div class="mobile-drawer-footer">
        <a href="/downloads" class="btn btn-primary btn-lg" style="width: 100%;">
          Get Lirune Reader
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      drawer.setAttribute('aria-hidden', String(expanded));
      drawer.classList.toggle('is-open', !expanded);
      document.body.classList.toggle('nav-locked', !expanded);
    });

    // Close when clicking a link
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.classList.remove('is-open');
        document.body.classList.remove('nav-locked');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass-nav);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-normal) var(--ease-out);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--sp-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
  }

  .brand-icon {
    border-radius: var(--r-md);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .brand:hover .brand-icon {
    transform: scale(1.05);
  }

  .brand-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding: 8px 12px;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--text-secondary);
    border-radius: var(--r-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .nav-link.active {
    color: var(--text-primary);
    background: rgba(238, 236, 248, 0.08);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .header-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-md);
    color: var(--text-secondary);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .header-action-btn:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .coffee-action:hover {
    color: var(--color-coffee);
  }

  .mobile-nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 36px;
    height: 36px;
    padding: 6px;
    border-radius: var(--r-md);
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-surface);
    z-index: 99;
    border-top: 1px solid var(--border-default);
    overflow-y: auto;
    padding: var(--sp-6);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: opacity var(--duration-normal) var(--ease-out),
                transform var(--duration-normal) var(--ease-out);
  }

  .mobile-nav-drawer.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .mobile-link {
    display: block;
    padding: 12px 16px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-radius: var(--r-lg);
  }

  .mobile-link:hover, .mobile-link.active {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .mobile-drawer-footer {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 980px) {
    .desktop-nav {
      display: none;
    }
    .header-download-btn {
      display: none;
    }
    .mobile-nav-toggle {
      display: flex;
    }
    .mobile-nav-drawer {
      display: block;
    }
  }
</style>
