---
import config from '../data/config.json';
import releases from '../data/releases.json';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');

const primaryNavLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/formats', label: 'Formats' },
  { href: '/downloads', label: 'Downloads' }
];

const moreLinks = [
  { href: '/screenshots', label: 'Screenshots', desc: 'Interface captures on Windows & Android' },
  { href: '/getting-started', label: 'Getting Started', desc: 'Step-by-step reader onboarding' },
  { href: '/changelog', label: 'Changelog', desc: 'Release milestones & security updates' },
  { href: '/faq', label: 'FAQ', desc: 'Frequently asked questions' },
  { href: '/privacy', label: 'Privacy Architecture', desc: 'Offline-first, zero telemetry model' },
  { href: '/licenses', label: 'Open Source Licenses', desc: 'GPL-3.0 and third-party notices' }
];

const isMoreActive = moreLinks.some(l => cleanPath === l.href);
---

<header class="site-header" id="site-header">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div class="site-container header-inner">
    <!-- Brand Identity -->
    <a href="/" class="brand-link" aria-label="Lirune Reader Homepage" aria-current={cleanPath === '/' ? 'page' : undefined}>
      <div class="brand-icon-wrapper">
        <img
          src="/images/branding/lirune-icon.png"
          alt="Lirune Icon"
          width="32"
          height="32"
          class="brand-icon site-brand-logo"
        />
      </div>
      <div class="brand-text">
        <span class="brand-name">Lirune</span>
        <span class="brand-sub">Reader</span>
      </div>
    </a>

    <!-- Desktop Navigation: Home, Features, Formats, Downloads, Support + More -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list" role="list">
        {primaryNavLinks.map(link => {
          const isActive = cleanPath === link.href;
          return (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}

        <!-- More Dropdown -->
        <li class="nav-item has-dropdown" data-dropdown="more">
          <button
            type="button"
            class:list={['nav-trigger', { active: isMoreActive }]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>More</span>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="dropdown-menu" role="menu">
            <div class="dropdown-list">
              {moreLinks.map(link => (
                <a
                  href={link.href}
                  class:list={['dropdown-link', { active: cleanPath === link.href }]}
                  role="menuitem"
                  aria-current={cleanPath === link.href ? 'page' : undefined}
                >
                  <span class="link-label">{link.label}</span>
                  <span class="link-desc">{link.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </li>
      </ul>

      <!-- Highlighted Support Action -->
      <a
        href="/support"
        class:list={['nav-coffee-btn', { active: cleanPath === '/support' }]}
        title="Support Lirune development"
        aria-current={cleanPath === '/support' ? 'page' : undefined}
      >
        <svg class="coffee-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.067 2.017.144l.228.031c.267.04.533.088.798.145.392.085.895.113 1.07.542.055.137.08.288.111.431l.319 1.484a.237.237 0 01-.199.284h-.003c-.037.006-.075.01-.112.015a36.704 36.704 0 01-4.743.295 37.059 37.059 0 01-4.699-.304c-.14-.017-.293-.042-.417-.06-.326-.048-.649-.108-.973-.161-.393-.065-.768-.032-1.123.161-.29.16-.527.404-.675.701-.154.316-.199.66-.267 1-.069.34-.176.707-.135 1.056.087.753.613 1.365 1.37 1.502a39.69 39.69 0 0011.343.376.483.483 0 01.535.53l-.071.697-1.018 9.907c-.041.41-.047.832-.125 1.237-.122.637-.553 1.028-1.182 1.171-.577.131-1.165.2-1.756.205-.656.004-1.31-.025-1.966-.022-.699.004-1.556-.06-2.095-.58-.475-.458-.54-1.174-.605-1.793l-.731-7.013-.322-3.094c-.037-.351-.286-.695-.678-.678-.336.015-.718.3-.678.679l.228 2.185.949 9.112c.147 1.344 1.174 2.068 2.446 2.272.742.12 1.503.144 2.257.156.966.016 1.942.053 2.892-.122 1.408-.258 2.465-1.198 2.616-2.657.34-3.332.683-6.663 1.024-9.995l.215-2.087a.484.484 0 01.39-.426c.402-.078.787-.212 1.074-.518.455-.488.546-1.124.385-1.766zm-1.478.772c-.145.137-.363.201-.578.233-2.416.359-4.866.54-7.308.46-1.748-.06-3.477-.254-5.207-.498-.17-.024-.353-.055-.47-.18-.22-.236