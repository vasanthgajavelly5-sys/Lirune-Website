---
import config from '../data/config.json';
import releases from '../data/releases.json';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const cleanPath = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');

const productLinks = [
  { href: '/features', label: 'Features', desc: 'Dual-page spreads, Scroll Engine v2, TTS & annotations' },
  { href: '/formats', label: 'Supported Formats (50+)', desc: '50+ document, ebook, spreadsheet, and image formats' },
  { href: '/screenshots', label: 'Screenshots', desc: '26 genuine Windows & Android interface captures' }
];

const exploreLinks = [
  { href: '/getting-started', label: 'Getting Started', desc: 'Step-by-step onboarding for Windows & Android' },
  { href: '/changelog', label: 'Changelog', desc: 'Release milestones and security updates' },
  { href: '/faq', label: 'Frequently Asked Questions', desc: 'Answers on privacy, formats, and storage' }
];

const aboutLinks = [
  { href: '/privacy', label: 'Privacy Policy', desc: 'Strict offline architecture and zero telemetry' },
  { href: '/licenses', label: 'Open Source Licenses', desc: 'GPL-3.0 terms and component attributions' },
  { href: '/support', label: 'Support & Community', desc: 'Buy Me a Coffee and GitHub contributions' }
];

const isProductActive = productLinks.some(l => cleanPath === l.href);
const isReleasesActive = cleanPath === '/downloads';
const isExploreActive = exploreLinks.some(l => cleanPath === l.href);
const isAboutActive = aboutLinks.some(l => cleanPath === l.href);
---

<header class="site-header" id="site-header">
  <div class="site-container header-inner">
    <!-- Brand Identity -->
    <a href="/" class="brand-link" aria-label="Lirune Reader Homepage">
      <div class="brand-icon-wrapper">
        <img
          src="/images/branding/lirune-icon.png"
          alt="Lirune Icon"
          width="32"
          height="32"
          class="brand-icon site-brand-logo"
        />
      </div>
      <div class="brand-text">
        <span class="brand-name">Lirune</span>
        <span class="brand-sub">Reader</span>
      </div>
    </a>

    <!-- Desktop Navigation Hierarchy: Product | Releases | Explore | About | Buy Me a Coffee -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <!-- 1. Product Dropdown -->
      <div class="nav-item has-dropdown" data-dropdown="product">
        <button
          type="button"
          class:list={['nav-trigger', { active: isProductActive }]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Product</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-arrow" aria-hidden="true"></div>
          <div class="dropdown-list">
            {productLinks.map(link => (
              <a
                href={link.href}
                class:list={['dropdown-link', { active: cleanPath === link.href }]}
                role="menuitem"
              >
                <span class="link-label">{link.label}</span>
                <span class="link-desc">{link.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 2. Releases Dropdown (Immediately after Product) -->
      <div class="nav-item has-dropdown" data-dropdown="releases">
        <button
          type="button"
          class:list={['nav-trigger', { active: isReleasesActive }]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Releases</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu dropdown-menu--releases" role="menu">
          <div class="dropdown-arrow" aria-hidden="true"></div>
          <div class="dropdown-list">
            <!-- Windows Platform Entry -->
            <a href="/downloads#windows" class="dropdown-link release-dropdown-link" role="menuitem">
              <div class="release-item-icon windows">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
                </svg>
              </div>
              <div class="release-item-info">
                <div class="release-item-title-row">
                  <span class="link-label">Windows</span>
                  <span class="release-badge windows">v{releases.windows.version} Stable</span>
                </div>
                <span class="link-desc">Installer (.exe) & Microsoft Store</span>
              </div>
            </a>

            <!-- Android Platform Entry -->
            <a href="/downloads#android" class="dropdown-link release-dropdown-link" role="menuitem">
              <div class="release-item-icon android">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"/>
                </svg>
              </div>
              <div class="release-item-info">
                <div class="release-item-title-row">
                  <span class="link-label">Android</span>
                  <span class="release-badge android">v{releases.android.version} Stable</span>
                </div>
                <span class="link-desc">Release APK (GitHub) • Zero Internet</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- 3. Explore Dropdown -->
      <div class="nav-item has-dropdown" data-dropdown="explore">
        <button
          type="button"
          class:list={['nav-trigger', { active: isExploreActive }]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Explore</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-arrow" aria-hidden="true"></div>
          <div class="dropdown-list">
            {exploreLinks.map(link => (
              <a
                href={link.href}
                class:list={['dropdown-link', { active: cleanPath === link.href }]}
                role="menuitem"
              >
                <span class="link-label">{link.label}</span>
                <span class="link-desc">{link.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 4. About Dropdown -->
      <div class="nav-item has-dropdown" data-dropdown="about">
        <button
          type="button"
          class:list={['nav-trigger', { active: isAboutActive }]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>About</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-arrow" aria-hidden="true"></div>
          <div class="dropdown-list">
            {aboutLinks.map(link => (
              <a
                href={link.href}
                class:list={['dropdown-link', { active: cleanPath === link.href }]}
                role="menuitem"
              >
                <span class="link-label">{link.label}</span>
                <span class="link-desc">{link.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 5. Buy Me a Coffee Button (Immediately after About) -->
      <a
        href={config.buyMeACoffeeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-coffee-btn"
        title="Support Lirune development on Buy Me a Coffee"
      >
        <svg class="coffee-icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.067 2.017.144l.228.031c.267.04.533.088.798.145.392.085.895.113 1.07.542.055.137.08.288.111.431l.319 1.484a.237.237 0 01-.199.284h-.003c-.037.006-.075.01-.112.015a36.704 36.704 0 01-4.743.295 37.059 37.059 0 01-4.699-.304c-.14-.017-.293-.042-.417-.06-.326-.048-.649-.108-.973-.161-.393-.065-.768-.032-1.123.161-.29.16-.527.404-.675.701-.154.316-.199.66-.267 1-.069.34-.176.707-.135 1.056.087.753.613 1.365 1.37 1.502a39.69 39.69 0 0011.343.376.483.483 0 01.535.53l-.071.697-1.018 9.907c-.041.41-.047.832-.125 1.237-.122.637-.553 1.028-1.182 1.171-.577.131-1.165.2-1.756.205-.656.004-1.31-.025-1.966-.022-.699.004-1.556-.06-2.095-.58-.475-.458-.54-1.174-.605-1.793l-.731-7.013-.322-3.094c-.037-.351-.286-.695-.678-.678-.336.015-.718.3-.678.679l.228 2.185.949 9.112c.147 1.344 1.174 2.068 2.446 2.272.742.12 1.503.144 2.257.156.966.016 1.942.053 2.892-.122 1.408-.258 2.465-1.198 2.616-2.657.34-3.332.683-6.663 1.024-9.995l.215-2.087a.484.484 0 01.39-.426c.402-.078.787-.212 1.074-.518.455-.488.546-1.124.385-1.766zm-1.478.772c-.145.137-.363.201-.578.233-2.416.359-4.866.54-7.308.46-1.748-.06-3.477-.254-5.207-.498-.17-.024-.353-.055-.47-.18-.22-.236-.111-.71-.054-.995.052-.26.152-.609.463-.646.484-.057 1.046.148 1.526.22.577.088 1.156.159 1.737.212 2.48.226 5.002.19 7.472-.14.45-.06.899-.13 1.345-.21.399-.072.84-.206 1.08.206.166.281.188.657.162.974a.544.544 0 01-.169.364zm-6.159 3.9c-.862.37-1.84.788-3.109.788a5.884 5.884 0 01-1.569-.217l.877 9.004c.065.78.717 1.38 1.5 1.38 0 0 1.243.065 1.658.065.447 0 1.786-.065 1.786-.065.783 0 1.434-.6 1.499-1.38l.94-9.95a3.996 3.996 0 00-1.322-.238c-.826 0-1.491.284-2.26.613z"/>
        </svg>
        <span>Buy Me a Coffee</span>
      </a>
    </nav>

    <!-- Header Actions (Theme Selector & Download CTA) -->
    <div class="header-actions">
      <!-- Theme Segmented Control -->
      <div class="theme-switch" role="group" aria-label="Color Theme Selection">
        <button
          type="button"
          class="theme-btn"
          data-theme-value="light"
          title="Switch to Light Theme"
          aria-label="Light Theme"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
        <button
          type="button"
          class="theme-btn"
          data-theme-value="system"
          title="Follow Operating System Theme"
          aria-label="System Theme"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </button>
        <button
          type="button"
          class="theme-btn"
          data-theme-value="dark"
          title="Switch to Dark Theme"
          aria-label="Dark Theme"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>

      <!-- Primary Action CTA -->
      <a href="/downloads" class:list={['btn', 'btn-primary', 'header-cta', { active: cleanPath === '/downloads' }]}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer" id="mobile-nav-drawer" hidden>
    <div class="mobile-drawer-scrim" id="mobile-drawer-scrim" aria-hidden="true"></div>
    <div class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-label="Navigation Menu">
      <div class="mobile-drawer-header">
        <div class="brand-link">
          <img src="/images/branding/lirune-icon.png" alt="" width="28" height="28" class="brand-icon" />
          <span class="brand-name">Lirune</span>
        </div>
        <button
          type="button"
          class="mobile-drawer-close"
          id="mobile-drawer-close-btn"
          aria-label="Close navigation menu"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="mobile-drawer-content">
        <!-- Section 1: Product -->
        <div class="mobile-nav-group">
          <div class="mobile-group-title">Product</div>
          {productLinks.map(link => (
            <a href={link.href} class:list={['mobile-nav-link', { active: cleanPath === link.href }]}>
              <span class="mobile-link-text">{link.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          ))}
        </div>

        <!-- Section 2: Releases -->
        <div class="mobile-nav-group">
          <div class="mobile-group-title">Releases</div>
          <a href="/downloads#windows" class="mobile-nav-link mobile-release-link">
            <div class="mobile-release-lead">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="windows-icon" aria-hidden="true">
                <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
              </svg>
              <span>Windows</span>
            </div>
            <span class="release-badge windows">v{releases.windows.version}</span>
          </a>
          <a href="/downloads#android" class="mobile-nav-link mobile-release-link">
            <div class="mobile-release-lead">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="android-icon" aria-hidden="true">
                <path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"/>
              </svg>
              <span>Android</span>
            </div>
            <span class="release-badge android">v{releases.android.version}</span>
          </a>
        </div>

        <!-- Section 3: Explore -->
        <div class="mobile-nav-group">
          <div class="mobile-group-title">Explore</div>
          {exploreLinks.map(link => (
            <a href={link.href} class:list={['mobile-nav-link', { active: cleanPath === link.href }]}>
              <span class="mobile-link-text">{link.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          ))}
        </div>

        <!-- Section 4: About -->
        <div class="mobile-nav-group">
          <div class="mobile-group-title">About</div>
          {aboutLinks.map(link => (
            <a href={link.href} class:list={['mobile-nav-link', { active: cleanPath === link.href }]}>
              <span class="mobile-link-text">{link.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          ))}
        </div>

        <!-- Section 5: Buy Me a Coffee Support Link -->
        <div class="mobile-nav-group">
          <a
            href={config.buyMeACoffeeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-coffee-link"
          >
            <svg class="coffee-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
