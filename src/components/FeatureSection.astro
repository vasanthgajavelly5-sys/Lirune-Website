---
import features from '../data/features.json';
---

<section class="features-section" id="features" aria-label="Core Capabilities">
  <div class="container">
    <div class="section-header text-center">
      <span class="section-label">Engineered for Readers</span>
      <h2 class="section-title">Designed with intention</h2>
      <p class="section-subtitle mx-auto">
        Every detail in Lirune is built around a single premise: reading on a computer or phone should feel peaceful, dependable, and completely private.
      </p>
    </div>

    <div class="features-list">
      {features.map((feat, index) => {
        const isEven = index % 2 === 1;
        return (
          <div class={`feature-row ${isEven ? 'reversed' : ''}`}>
            <!-- Text Column -->
            <div class="feature-text-col">
              <span class="badge badge-accent feature-badge">{feat.platform}</span>
              <h3 class="feature-title">{feat.title}</h3>
              <p class="feature-summary">{feat.summary}</p>

              <ul class="feature-points">
                {feat.points.map(pt => (
                  <li class="feature-point-item">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Screenshot Column -->
            <div class="feature-visual-col">
              {feat.platform.includes('Android') && !feat.platform.includes('Windows') ? (
                <div class="device-phone-frame clickable-shot" data-full={feat.screenshot} data-title={feat.title} data-caption={feat.summary}>
                  <div class="device-phone-notch"></div>
                  <img
                    src={feat.screenshot}
                    alt={feat.screenshotAlt}
                    width="320"
                    height="693"
                    loading="lazy"
                    decoding="async"
                    class="phone-screenshot-fit"
                  />
                  <div class="shot-zoom-badge" aria-hidden="true">Enlarge</div>
                </div>
              ) : (
                <div class="device-desktop-frame clickable-shot" data-full={feat.screenshot} data-title={feat.title} data-caption={feat.summary}>
                  <div class="device-desktop-header">
                    <div class="device-desktop-dots">
                      <span class="device-dot"></span>
                      <span class="device-dot"></span>
                      <span class="device-dot"></span>
                    </div>
                    <span class="device-desktop-title">Lirune — {feat.title}</span>
                  </div>
                  <img
                    src={feat.screenshot}
                    alt={feat.screenshotAlt}
                    width="1280"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class="desktop-screenshot-fit"
                  />
                  <div class="shot-zoom-badge" aria-hidden="true">Enlarge</div>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding-top: var(--sp-16);
    padding-bottom: var(--sp-20);
    background: #0E1218;
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-20);
    margin-top: var(--sp-12);
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--sp-12);
    align-items: center;
  }

  .feature-row.reversed {
    grid-template-columns: 1.15fr 1fr;
  }

  .feature-row.reversed .feature-text-col {
    order: 2;
  }

  .feature-row.reversed .feature-visual-col {
    order: 1;
  }

  .feature-badge {
    margin-bottom: var(--sp-3);
  }

  .feature-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    margin-bottom: var(--sp-4);
  }

  .feature-summary {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: var(--sp-6);
    color: var(--text-secondary);
  }

  .feature-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .feature-point-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    font-size: 0.98rem;
    color: var(--text-primary);
  }

  .check-icon {
    color: var(--accent-chrome);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .feature-visual-col {
    position: relative;
  }

  .clickable-shot {
    cursor: pointer;
    position: relative;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .clickable-shot:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
  }

  .shot-zoom-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(17, 21, 27, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--r-full);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .clickable-shot:hover .shot-zoom-badge {
    opacity: 1;
  }

  .desktop-screenshot-fit {
    width: 100%;
    height: auto;
    display: block;
  }

  .phone-screenshot-fit {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .feature-row, .feature-row.reversed {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }
    .feature-row.reversed .feature-text-col {
      order: 1;
    }
    .feature-row.reversed .feature-visual-col {
      order: 2;
    }
    .features-list {
      gap: var(--sp-12);
    }
  }
</style>
