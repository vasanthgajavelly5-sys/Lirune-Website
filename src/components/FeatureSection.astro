---
interface FeatureCard {
  id: string;
  icon: string;
  title: string;
  description: string;
  badge?: string;
}

const features: FeatureCard[] = [
  {
    id: "privacy",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    title: "Total Offline Privacy",
    description: "Your library never leaves your hardware with zero accounts, cloud tracking, or analytics telemetry. On Android, network permissions are permanently removed from production binaries.",
    badge: "100% Offline"
  },
  {
    id: "cross-platform",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`,
    title: "Tailored Cross-Platform UX",
    description: "Engineered specifically for desktop mouse interactions and mobile touchscreens. Enjoy dual-page spreads on Windows and one-handed reading with offline TTS audio on Android.",
    badge: "Windows & Android"
  },
  {
    id: "formats",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`,
    title: "50+ Formats Supported",
    description: "Read EPUB, PDF, CBZ/CBR comics, Office documents, spreadsheets, presentations, and images locally. Every format renders through hardened, sandboxed native parsers.",
    badge: "50+ Formats"
  },
  {
    id: "themes",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`,
    title: "Refined Themes & Typography",
    description: "Fine-tune margins, font sizing, line spacing, and color schemes including Obsidian Dark, Paper Cream, Nord, and Sepia. Crafted for prolonged eye comfort during long reading sessions.",
    badge: "Customizable"
  },
  {
    id: "performance",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
    title: "Scroll Engine v2 & Speed",
    description: "Continuous 60fps virtualized scrolling glides across multi-thousand-page volumes with zero stutter. Minimal memory and battery footprints keep your hardware cool and responsive.",
    badge: "60 FPS Virtualized"
  },
  {
    id: "opensource",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`,
    title: "GPL-3.0 Free & Open Source",
    description: "Built transparently with zero commercial surveillance, lock-in, or hidden monetization. Inspect the entire source code on GitHub, verify security guarantees, or compile your own binaries.",
    badge: "GPL-3.0"
  }
];
---

<section class="features-section section-spacing" id="features" aria-label="Key Product Features">
  <div class="site-container">
    <div class="section-header section-header--center" data-reveal>
      <span class="badge badge-accent">Core Capabilities</span>
      <h2>Designed with intention and craft</h2>
      <p>Every feature in Lirune is built around a single premise: reading on your computer or mobile device should be peaceful, dependable, and completely private.</p>
    </div>

    <!-- 3-Col Desktop, 2-Col Tablet, 1-Col Mobile CSS Grid -->
    <div class="features-grid">
      {features.map((feat) => (
        <div class="feature-card surface-card" data-reveal id={`card-${feat.id}`}>
          <div class="card-top">
            <div class="card-icon" aria-hidden="true" set:html={feat.icon} />
            {feat.badge && <span class="card-badge">{feat.badge}</span>}
          </div>
          <h3 class="card-title">{feat.title}</h3>
          <p class="card-desc">{feat.description}</p>
        </div>
      ))}
    </div>

    <div class="features-action-row" data-reveal>
      <a href="/features" class="btn btn-secondary btn-lg">
        <span>Deep dive into full engine capabilities →</span>
      </a>
      <a href="/formats" class="btn btn-subtle btn-lg">
        <span>View 50+ format compatibility table →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
    margin-top: var(--sp-10);
    margin-bottom: var(--sp-10);
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (max-width: 600px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
  }

  .feature-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: clamp(24px, 3.5vw, 32px);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--t-fast), box-shadow var(--t-fast), border-color var(--t-fast);
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-accent);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-4);
  }

  .card-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background-color: var(--accent-chrome-subtle);
    color: var(--accent-chrome);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-accent);
    flex-shrink: 0;
  }

  .card-badge {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: var(--r-sm);
    background-color: var(--bg-elevated);
    color: var(--text-tertiary);
    border: 1px solid var(--border-subtle);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--sp-3);
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .features-action-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-top: var(--sp-6);
  }
</style>
