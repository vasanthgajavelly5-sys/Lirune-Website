---
import config from '../data/config.json';
import releases from '../data/releases.json';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand & Identity -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand">
          <img src="/images/branding/lirune-icon.png" alt="Lirune Reader" width="32" height="32" />
          <span class="brand-text">Lirune</span>
        </a>
        <p class="footer-tagline">
          A calm, private home for your library on Windows and Android. Free, open source, and offline by design.
        </p>
        <div class="footer-badges">
          <span class="badge badge-accent">Windows v{releases.windows.version}</span>
          <span class="badge badge-success">Android v{releases.android.version}</span>
          <span class="badge">GPL-3.0</span>
        </div>
      </div>

      <!-- Col 2: Product -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Product</h4>
        <ul class="footer-links-list">
          <li><a href="/features">Features</a></li>
          <li><a href="/formats">Supported Formats (19)</a></li>
          <li><a href="/screenshots">Live Screenshots</a></li>
          <li><a href="/downloads">Download Hub</a></li>
          <li><a href="/changelog">What's New / Releases</a></li>
          <li><a href="/getting-started">Getting Started Guide</a></li>
        </ul>
      </div>

      <!-- Col 3: Platforms & Stores -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Downloads</h4>
        <ul class="footer-links-list">
          <li>
            <a href={releases.windows.storeUrl} target="_blank" rel="noopener noreferrer">
              Microsoft Store (Official)
            </a>
          </li>
          <li>
            <a href={releases.windows.installerUrl}>
              Windows Installer (.exe)
            </a>
          </li>
          <li>
            <a href={releases.android.apkUrl}>
              Android Direct APK
            </a>
          </li>
          <li>
            <a href={config.githubReleases} target="_blank" rel="noopener noreferrer">
              All GitHub Releases
            </a>
          </li>
          <li>
            <a href="/downloads#verification">
              SHA-256 Checksums
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Open Source & Legal -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Open Source</h4>
        <ul class="footer-links-list">
          <li>
            <a href={config.githubRepo} target="_blank" rel="noopener noreferrer">
              GitHub Repository
            </a>
          </li>
          <li>
            <a href={config.githubIssues} target="_blank" rel="noopener noreferrer">
              Report an Issue / Bug
            </a>
          </li>
          <li><a href="/licenses">Licenses & Third-Party</a></li>
          <li><a href="/privacy">Privacy Architecture</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li>
            <a href={config.buyMeACoffeeUrl} target="_blank" rel="noopener noreferrer" class="coffee-link">
              Buy Me a Coffee
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom Row -->
    <div class="footer-bottom-row">
      <div class="footer-copyright">
        <p>{config.copyright}. Licensed under the <a href="/licenses" class="footer-inline-link">GNU General Public License v3.0</a>.</p>
        <p class="footer-disclaimer">
          EPUB is a registered trademark of the W3C. Windows and Microsoft Store are trademarks of Microsoft Corporation. Android is a trademark of Google LLC.
        </p>
      </div>

      <div class="footer-social-links">
        <a href={config.buyMeACoffeeUrl} target="_blank" rel="noopener noreferrer" class="social-btn coffee-btn" title="Support on Buy Me a Coffee" aria-label="Buy Me a Coffee">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v2M14 3v2M5 8h14l-1.2 10.1A3.3 3.3 0 0 1 14.5 21h-5a3.3 3.3 0 0 1-3.3-2.9L5 8Z"/><path d="M19 10h1a2 2 0 0 1 0 4h-1M8 11v4M12 11v4M16 11v4"/></svg>
        </a>
        <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="social-btn" title="GitHub Repository" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0B0E13;
    border-top: 1px solid var(--border-default);
    padding-top: var(--sp-16);
    padding-bottom: var(--sp-10);
    margin-top: auto;
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: var(--sp-10);
    margin-bottom: var(--sp-12);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .brand-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .footer-tagline {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: var(--sp-4);
    max-width: 320px;
  }

  .footer-badges {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin-bottom: var(--sp-4);
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .footer-links-list a {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .footer-links-list a:hover {
    color: var(--accent);
  }

  .coffee-link {
    color: var(--color-coffee) !important;
    font-weight: 600;
  }

  .footer-bottom-row {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--sp-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  .footer-copyright p {
    font-size: 0.82rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .footer-disclaimer {
    margin-top: 4px;
    font-size: 0.76rem;
  }

  .footer-inline-link {
    color: var(--accent-chrome);
    text-decoration: underline;
  }

  .footer-social-links {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .social-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .social-btn:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
    border-color: var(--border-strong);
  }

  .coffee-btn:hover {
    color: var(--color-coffee);
  }

  @media (max-width: 900px) {
    .footer-top-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-8);
    }
  }

  @media (max-width: 560px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
