---
import config from '../data/config.json';
import releases from '../data/releases.json';
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <div class="footer-top">
      <!-- Brand & Mission Column -->
      <div class="footer-brand">
        <div class="brand-link">
          <div class="brand-icon-wrapper">
            <img src="/images/branding/lirune-icon.png" alt="" width="28" height="28" class="brand-icon" />
          </div>
          <span class="brand-name">Lirune Reader</span>
        </div>
        <p class="footer-tagline">
          Made with privacy in mind. A calm, private home for your library on Windows and Android. Free, open-source, and offline-first with zero tracking.
        </p>
        <div class="footer-version-pills">
          <span class="version-pill">
            <span class="pill-dot windows"></span> Windows v{releases.windows.version}
          </span>
          <span class="version-pill">
            <span class="pill-dot android"></span> Android v{releases.android.version}
          </span>
        </div>
      </div>

      <!-- 3-Column Nav Grid: Product links | Resources | Social/Legal -->
      <div class="footer-nav-grid">
        <!-- Column 1: Product -->
        <div class="footer-col">
          <h3 class="footer-col-title">Product</h3>
          <ul class="footer-links" role="list">
            <li><a href="/features">Features & Engine</a></li>
            <li><a href="/formats">Supported Formats (50+)</a></li>
            <li><a href="/screenshots">Screenshot Gallery</a></li>
            <li><a href="/downloads">Download Hub</a></li>
          </ul>
        </div>

        <!-- Column 2: Resources -->
        <div class="footer-col">
          <h3 class="footer-col-title">Resources</h3>
          <ul class="footer-links" role="list">
            <li><a href="/getting-started">Getting Started</a></li>
            <li><a href="/changelog">Changelog & Releases</a></li>
            <li><a href="/faq">Frequently Asked Questions</a></li>
            <li><a href={config.githubRepo} target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a></li>
          </ul>
        </div>

        <!-- Column 3: Social & Legal -->
        <div class="footer-col">
          <h3 class="footer-col-title">Social & Legal</h3>
          <ul class="footer-links" role="list">
            <li><a href="/privacy">Privacy Architecture</a></li>
            <li><a href="/licenses">GPL-3.0 Licenses</a></li>
            <li><a href="/support">Support Development</a></li>
            <li><a href={config.buyMeACoffeeUrl} target="_blank" rel="noopener noreferrer">Buy Me a Coffee ↗</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Privacy Statement Summary Banner -->
    <div class="footer-privacy-summary">
      <div class="privacy-summary-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <div class="privacy-summary-text">
        <strong>Privacy Statement:</strong> Lirune Reader is built offline-first. It executes zero telemetry, transmits zero analytics or personal data to remote servers, and keeps your entire library strictly on your device.
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">
        <p>© 2026 Vasanth Gajavelly. Free and open source software under the <a href="/licenses">GNU General Public License v3.0</a>.</p>
        <p class="footer-subcopy">All book titles, covers, and excerpts shown in screenshots belong to their respective authors and public domain editions.</p>
      </div>

      <div class="footer-badges">
        <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="badge-link store-badge" title="View Lirune Reader on Microsoft Store">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
          </svg>
          <span>Microsoft Store</span>
        </a>
        <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="badge-link github-badge" title="Inspect source code on GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--border-subtle);
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(32px, 4vw, 48px);
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: 340px 1fr;
      gap: clamp(48px, 6vw, 96px);
    }
  }

  /* Brand Column */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    text-decoration: none;
  }

  .brand-icon-wrapper {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-name {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .footer-tagline {
    font-size: 0.92rem;
    color: var(--color-secondary);
    line-height: 1.55;
    max-width: 320px;
  }

  .footer-version-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .version-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-default);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pill-dot.windows { background-color: var(--color-windows); }
  .pill-dot.android { background-color: var(--color-android); }

  /* 3-Column Nav Grid (Stacks to 1 column on mobile) */
  .footer-nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  @media (min-width: 520px) {
    .footer-nav-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-6);
    }
  }

  .footer-col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: var(--spacing-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 0.9rem;
    color: var(--color-secondary);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  /* Privacy Statement Summary Box */
  .footer-privacy-summary {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    padding: var(--spacing-4) var(--spacing-5);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .privacy-summary-icon {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .privacy-summary-text {
    font-size: 0.85rem;
    color: var(--color-secondary);
    line-height: 1.55;
  }

  .privacy-summary-text strong {
    color: var(--color-text);
  }

  /* Bottom Bar */
  .footer-bottom {
    padding-top: var(--spacing-6);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
    justify-content: space-between;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }

  .footer-copy a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-copy a:hover {
    color: var(--color-text);
  }

  .footer-subcopy {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .footer-badges {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .badge-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-default);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--t-fast);
  }

  .badge-link:hover {
    border-color: var(--border-strong);
    background-color: var(--bg-hover);
    transform: translateY(-1px);
  }
</style>
