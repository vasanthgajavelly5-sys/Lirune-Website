---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';

const thirdPartyNotices = [
  { name: 'PDF.js', license: 'Apache-2.0', desc: 'Mozilla PDF parsing and rendering engine' },
  { name: 'DOMPurify', license: 'Apache-2.0 / MPL-2.0', desc: 'Strict HTML sanitization for FB2, HTML, and Markdown' },
  { name: 'JSZip', license: 'MIT', desc: 'Archive decompression and Zip-Slip protection' },
  { name: 'SQLite', license: 'Public Domain', desc: 'Embedded relational database for local library storage' },
  { name: 'epubjs', license: 'FreeBSD', desc: 'EPUB 2 / 3 container parsing and spine mapping' }
];
---

<BaseLayout
  title="Open Source Licenses & Third-Party Notices — Lirune Reader"
  description="Lirune Reader is free software licensed under the GNU General Public License v3.0 (GPL-3.0). Review copyleft rights and third-party notices."
  canonicalPath="/licenses"
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="section-header">
      <span class="badge badge-success">Open Source</span>
      <h1>Licenses & Legal Notices</h1>
      <p>Lirune Reader is committed to copyleft software freedom, transparent source code, and respect for open-source libraries.</p>
    </div>

    <!-- GPL-3.0 License Summary -->
    <section class="license-block surface-card">
      <div class="license-header">
        <div>
          <span class="license-badge">GPL-3.0</span>
          <h2>GNU General Public License v3.0</h2>
        </div>
        <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>Read Full License Text ↗</span>
        </a>
      </div>

      <p class="license-desc">
        Copyright © 2026 Vasanth Gajavelly. Lirune Reader is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version.
      </p>

      <div class="license-freedoms">
        <div class="freedom-item">
          <h3>Freedom 0</h3>
          <p>The freedom to run the program as you wish, for any purpose.</p>
        </div>
        <div class="freedom-item">
          <h3>Freedom 1</h3>
          <p>The freedom to study how the program works, and change it so it does your computing as you wish.</p>
        </div>
        <div class="freedom-item">
          <h3>Freedom 2</h3>
          <p>The freedom to redistribute copies so you can help your neighbor.</p>
        </div>
        <div class="freedom-item">
          <h3>Freedom 3</h3>
          <p>The freedom to distribute copies of your modified versions to others.</p>
        </div>
      </div>
    </section>

    <!-- Third-Party Notices -->
    <section class="third-party-section">
      <h2>Third-Party Open Source Notices</h2>
      <p>Lirune Reader incorporates several outstanding open-source libraries and rendering engines:</p>

      <div class="notices-list">
        {thirdPartyNotices.map(n => (
          <div class="notice-card surface-card">
            <div class="notice-header">
              <h3 class="notice-name">{n.name}</h3>
              <span class="notice-license">{n.license}</span>
            </div>
            <p class="notice-desc">{n.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .license-block {
    padding: clamp(28px, 5vw, 44px);
    margin-bottom: var(--sp-12);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .license-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .license-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .license-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--r-sm);
    background-color: var(--accent-chrome-subtle);
    color: var(--accent-chrome);
    display: inline-block;
    margin-bottom: 6px;
  }

  .license-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .license-freedoms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-4);
  }

  .freedom-item {
    padding: 14px 18px;
    border-radius: var(--r-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .freedom-item h3 {
    font-size: 0.9rem;
    color: var(--accent);
  }

  .freedom-item p {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  /* Third-party notices */
  .third-party-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .notices-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .notice-card {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .notice-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .notice-name {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .notice-license {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: var(--r-sm);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-default);
    color: var(--text-tertiary);
  }

  .notice-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
</style>
