---
import BaseLayout from '../layouts/BaseLayout.astro';

const windowsShots = [
  {
    src: "/images/screenshots/win-library-grid.png",
    title: "Library Grid View",
    category: "Library",
    caption: "Main library overview displaying book covers, reading progress badges, and Ctrl+K search."
  },
  {
    src: "/images/screenshots/win-library-empty.png",
    title: "First Launch & Drop-Zone",
    category: "Library",
    caption: "Clean start screen guiding users to drag and drop books or folders directly into Lirune."
  },
  {
    src: "/images/screenshots/win-reader-story.png",
    title: "Reflowable Story Reader",
    category: "Reader",
    caption: "Reflowable reading mode with elegant typography, chapter headers, and reading progress."
  },
  {
    src: "/images/screenshots/win-reader-epub-spread.png",
    title: "Two-Page Book Spread",
    category: "Reader",
    caption: "Dual-page spread view recreating the natural feel of an open book on desktop screens."
  },
  {
    src: "/images/screenshots/win-reader-flow-scroll.png",
    title: "Continuous Vertical Flow",
    category: "Reader",
    caption: "Smooth vertical scrolling mode without artificial page turns."
  },
  {
    src: "/images/screenshots/win-reader-pdf.png",
    title: "PDF Document Viewer",
    category: "Reader",
    caption: "Integrated offline PDF.js viewer with zoom controls and fit-to-width."
  },
  {
    src: "/images/screenshots/win-reader-cbz.png",
    title: "Comic Book Archive Reader",
    category: "Formats",
    caption: "High-resolution image archive viewer supporting CBZ, CBR, and CB7 formats."
  },
  {
    src: "/images/screenshots/win-reader-docx.png",
    title: "Word Document Reader",
    category: "Formats",
    caption: "Clean, reflowable rendering of Microsoft Word documents (.docx) without office bloat."
  },
  {
    src: "/images/screenshots/win-reader-toc.png",
    title: "Table of Contents Drawer",
    category: "Navigation",
    caption: "Slide-out navigation drawer with filterable chapter titles and position tracking."
  },
  {
    src: "/images/screenshots/win-reader-search.png",
    title: "In-Book Text Search",
    category: "Search",
    caption: "Fast in-book text search with match counters and jump navigation."
  },
  {
    src: "/images/screenshots/win-reader-annotations.png",
    title: "Highlights & Annotations",
    category: "Study",
    caption: "Highlights drawer with multi-color highlights, notes, and Markdown export."
  },
  {
    src: "/images/screenshots/win-quick-settings.png",
    title: "Quick Appearance Settings",
    category: "Settings",
    caption: "Instant access to layout switches, font scaling, and theme presets."
  },
  {
    src: "/images/screenshots/win-settings-reading.png",
    title: "Typography & Theme Settings",
    category: "Settings",
    caption: "Granular controls for line height, page margins, reading themes, and font families."
  },
  {
    src: "/images/screenshots/win-settings-storage.png",
    title: "Storage & Backup Maintenance",
    category: "Settings",
    caption: "Manage local data storage, database size, and export complete library backups."
  },
  {
    src: "/images/screenshots/win-settings-shortcuts.png",
    title: "Keyboard Shortcuts Reference",
    category: "Settings",
    caption: "Comprehensive cheat sheet for keyboard navigation and reader commands."
  },
  {
    src: "/images/screenshots/win-settings-about.png",
    title: "About & Open Source Credits",
    category: "Settings",
    caption: "Software version, author credentials, GPL-3.0 license, and Buy Me a Coffee link."
  }
];

const androidShots = [
  {
    src: "/images/screenshots/android-library.png",
    title: "Android Home Library",
    category: "Library",
    caption: "Mobile library screen showing book covers, reading progress, and quick search."
  },
  {
    src: "/images/screenshots/android-reader-epub.png",
    title: "Scroll Engine v2",
    category: "Reader",
    caption: "Fluid 60fps virtualized continuous scrolling on mobile screens."
  },
  {
    src: "/images/screenshots/android-reader-controls.png",
    title: "Touch Reader Controls",
    category: "Reader",
    caption: "Overlay controls for brightness, font scaling, theme presets, and chapter scrubbing."
  },
  {
    src: "/images/screenshots/android-reader-toc.png",
    title: "Interactive TOC Drawer",
    category: "Navigation",
    caption: "Touch-friendly table of contents with chapter jumping and progress indicators."
  },
  {
    src: "/images/screenshots/android-reader-bookmark.png",
    title: "Bookmarks & Reading History",
    category: "Study",
    caption: "Keep track of bookmarked pages, reading sessions, and progress milestones."
  },
  {
    src: "/images/screenshots/android-navigation-drawer.png",
    title: "App Navigation Drawer",
    category: "Navigation",
    caption: "Slide-out drawer providing fast switching between Library, Favorites, and Settings."
  },
  {
    src: "/images/screenshots/android-tts-player.png",
    title: "Offline Text-to-Speech Narration",
    category: "Audio",
    caption: "Audio playback player with playback controls and speech rate adjustment."
  },
  {
    src: "/images/screenshots/android-import-discovery.png",
    title: "Document Discovery via SAF",
    category: "Import",
    caption: "Storage Access Framework folder browsing without requiring broad storage permissions."
  }
];
---

<BaseLayout
  title="Live Application Screenshots — Lirune Reader"
  description="Explore the authentic visual gallery of Lirune Reader. Real screenshots from Windows desktop and Android applications in the official default theme."
>
  <div class="screenshots-page">
    <div class="container">
      <div class="page-header text-center">
        <span class="section-label">Visual Gallery</span>
        <h1 class="page-title">Live Application Showcase</h1>
        <p class="page-subtitle mx-auto">
          Every image below is captured directly from running builds of Lirune Reader on Windows and Android. No mockups or artificial designs.
        </p>
      </div>

      <!-- Windows Screenshots Section -->
      <section class="gallery-block">
        <div class="block-header">
          <div class="header-tag">
            <svg width="22" height="22" viewBox="0 0 88 88" fill="currentColor" aria-hidden="true">
              <path d="M0 12.402l35.689-4.86.016 34.423-35.67.203zm35.67 33.529l.026 34.453-35.67-4.887-.026-29.566zm4.326-39.043L87.914 0v41.525l-47.918.278zm47.918 48.749L39.996 88V46.541l47.918.257z"/>
            </svg>
            <h2>Windows Desktop Gallery</h2>
          </div>
          <p>Captured on Windows 11 in default dark mode.</p>
        </div>

        <div class="gallery-grid-desktop">
          {windowsShots.map(shot => (
            <div class="gallery-item-desktop card clickable-shot" data-full={shot.src} data-title={shot.title} data-caption={shot.caption}>
              <div class="device-desktop-frame">
                <div class="device-desktop-header">
                  <div class="device-desktop-dots">
                    <span class="device-dot"></span>
                    <span class="device-dot"></span>
                    <span class="device-dot"></span>
                  </div>
                  <span class="device-desktop-title">Lirune — {shot.title}</span>
                </div>
                <img src={shot.src} alt={shot.title} width="800" height="500" loading="lazy" />
                <div class="shot-zoom-badge">Click to enlarge</div>
              </div>
              <div class="item-meta">
                <span class="badge badge-accent item-cat">{shot.category}</span>
                <h3 class="item-title">{shot.title}</h3>
                <p class="item-caption">{shot.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Android Screenshots Section -->
      <section class="gallery-block">
        <div class="block-header">
          <div class="header-tag">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.1 12 8.1s-3.5902.3116-5.1367.8497L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
            </svg>
            <h2>Android Mobile Gallery</h2>
          </div>
          <p>Captured on Android 14 in default dark appearance.</p>
        </div>

        <div class="gallery-grid-mobile">
          {androidShots.map(shot => (
            <div class="gallery-item-mobile card clickable-shot" data-full={shot.src} data-title={shot.title} data-caption={shot.caption}>
              <div class="device-phone-frame">
                <div class="device-phone-notch"></div>
                <img src={shot.src} alt={shot.title} width="320" height="693" loading="lazy" />
                <div class="shot-zoom-badge">Enlarge</div>
              </div>
              <div class="item-meta text-center">
                <span class="badge badge-success item-cat">{shot.category}</span>
                <h3 class="item-title">{shot.title}</h3>
                <p class="item-caption">{shot.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .screenshots-page {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-20);
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .page-header {
    margin-bottom: var(--sp-16);
  }

  .page-title {
    margin-bottom: var(--sp-4);
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 680px;
  }

  .gallery-block {
    margin-bottom: var(--sp-20);
  }

  .block-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--sp-4);
    margin-bottom: var(--sp-10);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .header-tag {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .header-tag svg {
    color: var(--accent-chrome);
  }

  .block-header h2 {
    font-size: 1.6rem;
  }

  .block-header p {
    font-size: 0.92rem;
    color: var(--text-tertiary);
  }

  .gallery-grid-desktop {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--sp-8);
  }

  .gallery-item-desktop {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .gallery-item-desktop:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .item-meta {
    margin-top: var(--sp-4);
  }

  .item-cat {
    margin-bottom: var(--sp-2);
  }

  .item-title {
    font-size: 1.15rem;
    font-weight: 650;
    margin-bottom: 4px;
    color: var(--text-primary);
  }

  .item-caption {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .gallery-grid-mobile {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-8);
  }

  .gallery-item-mobile {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .gallery-item-mobile:hover {
    transform: translateY(-3px);
  }

  .shot-zoom-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(17, 21, 27, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--r-full);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .clickable-shot:hover .shot-zoom-badge {
    opacity: 1;
  }
</style>
