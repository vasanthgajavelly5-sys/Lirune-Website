---
import BaseLayout from '../layouts/BaseLayout.astro';

interface ScreenshotItem {
  src: string;
  title: string;
  platform: 'Windows' | 'Android';
  category: 'Library' | 'Reader' | 'Settings';
  desc: string;
}

const screenshots: ScreenshotItem[] = [
  // Windows - Library & Shell
  {
    src: '/images/screenshots/win-library-grid.png',
    title: 'Windows Library Grid View',
    platform: 'Windows',
    category: 'Library',
    desc: 'Library browsing with rendered book covers, author metadata, reading progress indicators, and sorting controls.'
  },
  {
    src: '/images/screenshots/win-library-empty.png',
    title: 'Windows Empty State & Drop Zone',
    platform: 'Windows',
    category: 'Library',
    desc: 'Clean drag-and-drop import zone with clear format cues for adding new digital books.'
  },
  // Windows - Readers
  {
    src: '/images/screenshots/win-reader-epub-spread.png',
    title: 'Two-Page Book Spread',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Dual-page book spread delivering an authentic hardbound book reading experience on wide displays.'
  },
  {
    src: '/images/screenshots/win-reader-epub-single.png',
    title: 'Single-Column Continuous Flow',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Focused single-column reading with customizable line length and generous typographic margins.'
  },
  {
    src: '/images/screenshots/win-reader-pdf.png',
    title: 'High-Fidelity PDF Viewer',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Offline PDF.js integration with page zoom, fit-to-width, and document thumbnail drawer.'
  },
  {
    src: '/images/screenshots/win-reader-story.png',
    title: 'FB2 Fiction Story Mode',
    platform: 'Windows',
    category: 'Reader',
    desc: 'FictionBook 2 renderer with DOMPurify script sanitization and comfortable serif reading font.'
  },
  {
    src: '/images/screenshots/win-reader-cbz.png',
    title: 'CBZ / CBR Graphic Novel Viewer',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Full-bleed comic book archive rendering with zero image compression degradation.'
  },
  {
    src: '/images/screenshots/win-reader-docx.png',
    title: 'DOCX Document Reader',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Microsoft Word document parser rendering clean, formatted chapters offline.'
  },
  {
    src: '/images/screenshots/win-reader-toc.png',
    title: 'Table of Contents Navigation',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Sidebar drawer listing multi-level chapters with one-click page jumps.'
  },
  {
    src: '/images/screenshots/win-reader-search.png',
    title: 'Full-Text Search Modal',
    platform: 'Windows',
    category: 'Reader',
    desc: 'In-book keyword search with preview snippets and direct result navigation.'
  },
  {
    src: '/images/screenshots/win-reader-annotations.png',
    title: 'Annotations & Bookmarks Drawer',
    platform: 'Windows',
    category: 'Reader',
    desc: 'Local highlights, bookmarks, and user reading notes stored safely on the filesystem.'
  },
  {
    src: '/images/screenshots/win-quick-settings.png',
    title: 'Quick Appearance Menu',
    platform: 'Windows',
    category: 'Settings',
    desc: 'Instant in-reader controls for font size, line height, background theme, and margin widths.'
  },
  // Windows - Settings Tabs
  {
    src: '/images/screenshots/win-settings-general.png',
    title: 'General Settings',
    platform: 'Windows',
    category: 'Settings',
    desc: 'Startup view selection, theme preference, and default library sorting rules.'
  },
  {
    src: '/images/screenshots/win-settings-reading.png',
    title: 'Reading Experience Settings',
    platform: 'Windows',
    category: 'Settings',
    desc: 'Configurable page-turn transitions, font smoothing, and text alignment preferences.'
  },
  {
    src: '/images/screenshots/win-settings-storage.png',
    title: 'Local Storage & Cache Manager',
    platform: 'Windows',
    category: 'Settings',
    desc: 'Inspect SQLite database location, image cache usage, and local indexing paths.'
  },
  {
    src: '/images/screenshots/win-settings-shortcuts.png',
    title: 'Keyboard Shortcuts Reference',
    platform: 'Windows',
    category: 'Settings',
    desc: 'Complete keymapping for keyboard-only reading navigation and fullscreen toggle.'
  },
  {
    src: '/images/screenshots/win-settings-about.png',
    title: 'About & Open Source Credits',
    platform: 'Windows',
    category: 'Settings',
    desc: 'Application version, GPL-3.0 copyleft terms, and third-party library attributions.'
  },
  // Android Screenshots
  {
    src: '/images/screenshots/android-library.png',
    title: 'Android Mobile Library',
    platform: 'Android',
    category: 'Library',
    desc: 'Modern edge-to-edge Android library with cover thumbnails and reading progress chips.'
  },
  {
    src: '/images/screenshots/android-reader-epub.png',
    title: 'Scroll Engine v2 EPUB Reader',
    platform: 'Android',
    category: 'Reader',
    desc: 'Smooth 60fps continuous virtualized vertical scrolling with serif typography.'
  },
  {
    src: '/images/screenshots/android-reader-controls.png',
    title: 'Android Reading Controls Bar',
    platform: 'Android',
    category: 'Settings',
    desc: 'Quick bottom sheet for font sizing, theme palette selection, and screen brightness.'
  },
  {
    src: '/images/screenshots/android-reader-toc.png',
    title: 'Android Table of Contents Sheet',
    platform: 'Android',
    category: 'Reader',
    desc: 'Sliding bottom sheet displaying chapter titles and reading progress percentages.'
  },
  {
    src: '/images/screenshots/android-reader-bookmark.png',
    title: 'Android Bookmark Creation',
    platform: 'Android',
    category: 'Reader',
    desc: 'One-tap bookmarking with custom labels saved to the local device SQLite store.'
  },
  {
    src: '/images/screenshots/android-navigation-drawer.png',
    title: 'Android Navigation Drawer',
    platform: 'Android',
    category: 'Library',
    desc: 'Slide-out navigation drawer providing fast access to categories, recents, and settings.'
  },
  {
    src: '/images/screenshots/android-tts-player.png',
    title: 'Offline Text-to-Speech Narration',
    platform: 'Android',
    category: 'Reader',
    desc: 'Audio narration bar with play/pause, voice speech rate slider, and background service.'
  },
  {
    src: '/images/screenshots/android-import-discovery.png',
    title: 'Storage Access Framework Import',
    platform: 'Android',
    category: 'Library',
    desc: 'Select local document folders directly using Android SAF without blanket storage permissions.'
  }
];

const platforms = ['All', 'Windows', 'Android'];
const categories = ['All', 'Reader', 'Library', 'Settings'];
---

<BaseLayout
  title="Live Application Screenshots — Lirune Reader"
  description="Inspect 26 genuine screenshots captured from the running Windows and Android Lirune Reader applications in full resolution."
  canonicalPath="/screenshots"
>
  <div class="site-container section-spacing">
    <div class="section-header section-header--center">
      <span class="badge badge-success">Authentic UI</span>
      <h1>Application Screenshots</h1>
      <p>Real, unedited captures from the running Windows and Android builds. Click any screenshot for a full-resolution preview.</p>
    </div>

    <!-- Filter Bar -->
    <div class="gallery-filter-card">
      <div class="filter-group">
        <span class="filter-group-label">Platform:</span>
        <div class="filter-buttons" id="platform-filters">
          {platforms.map((p, idx) => (
            <button
              type="button"
              class:list={['filter-btn', { active: idx === 0 }]}
              data-platform={p}
            >
              {p}
            </button>
          ))}
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-group-label">Category:</span>
        <div class="filter-buttons" id="category-filters">
          {categories.map((c, idx) => (
            <button
              type="button"
              class:list={['filter-btn', { active: idx === 0 }]}
              data-category={c}
            >
              {c}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Screenshots Grid -->
    <div class="screenshots-masonry-grid" id="screenshots-grid">
      {screenshots.map(s => (
        <article
          class="shot-card surface-card clickable-shot"
          data-platform={s.platform}
          data-category={s.category}
          data-shot-src={s.src}
          data-shot-title={s.title}
          data-shot-platform={s.platform}
          data-shot-caption={s.desc}
          tabindex="0"
          role="button"
          aria-label={`Open ${s.platform} screenshot: ${s.title}`}
        >
          <div class="shot-img-wrap">
            <img
              src={s.src}
              alt={`${s.platform} — ${s.title}`}
              width="600"
              height="380"
              loading="lazy"
              class="shot-thumb"
            />
            <div class="shot-hover-overlay" aria-hidden="true">
              <span class="hover-zoom-icon">🔍 Click to enlarge</span>
            </div>
          </div>

          <div class="shot-meta">
            <div class="shot-tags">
              <span class:list={['shot-platform-tag', s.platform.toLowerCase()]}>{s.platform}</span>
              <span class="shot-category-tag">{s.category}</span>
            </div>
            <h3 class="shot-title">{s.title}</h3>
            <p class="shot-desc">{s.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .gallery-filter-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: var(--sp-6);
    margin-bottom: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 768px) {
    .gallery-filter-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .filter-group-label {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }

  .filter-buttons {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 6px 14px;
    border-radius: var(--r-full);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
  }

  .filter-btn.active {
    background-color: var(--accent);
    color: var(--text-on-accent);
    font-weight: 600;
    border-color: transparent;
  }

  /* Screenshots Grid */
  .screenshots-masonry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 640px) {
    .screenshots-masonry-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .screenshots-masonry-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .shot-card {
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    transition: all var(--t-fast);
  }

  .shot-card:hover {
    border-color: var(--border-default);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .shot-img-wrap {
    position: relative;
    width: 100%;
    background-color: var(--bg-subtle);
    overflow: hidden;
  }

  .shot-thumb {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform var(--t-normal);
  }

  .shot-card:hover .shot-thumb {
    transform: scale(1.03);
  }

  .shot-hover-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(15, 18, 23, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--t-fast);
  }

  .shot-card:hover .shot-hover-overlay {
    opacity: 1;
  }

  .hover-zoom-icon {
    font-size: 0.85rem;
    font-weight: 600;
    color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 6px 12px;
    border-radius: var(--r-full);
    backdrop-filter: blur(4px);
  }

  .shot-meta {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 auto;
  }

  .shot-tags {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .shot-platform-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--r-sm);
  }

  .shot-platform-tag.windows {
    background-color: rgba(0, 120, 215, 0.15);
    color: var(--color-windows);
  }

  .shot-platform-tag.android {
    background-color: rgba(61, 220, 132, 0.15);
    color: var(--color-android);
  }

  .shot-category-tag {
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: var(--r-sm);
    background-color: var(--bg-subtle);
    color: var(--text-tertiary);
  }

  .shot-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .shot-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }
</style>

<script>
  function setupGalleryFilters() {
    const platformBtns = document.querySelectorAll<HTMLButtonElement>('#platform-filters .filter-btn');
    const categoryBtns = document.querySelectorAll<HTMLButtonElement>('#category-filters .filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.shot-card');

    let activePlatform = 'All';
    let activeCategory = 'All';

    function filterCards() {
      cards.forEach(card => {
        const plat = card.getAttribute('data-platform') || '';
        const cat = card.getAttribute('data-category') || '';

        const matchesPlat = activePlatform === 'All' || plat === activePlatform;
        const matchesCat = activeCategory === 'All' || cat === activeCategory;

        if (matchesPlat && matchesCat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    platformBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        platformBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activePlatform = btn.getAttribute('data-platform') || 'All';
        filterCards();
      });
    });

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.getAttribute('data-category') || 'All';
        filterCards();
      });
    });
  }

  setupGalleryFilters();
  document.addEventListener('astro:page-load', setupGalleryFilters);
</script>
