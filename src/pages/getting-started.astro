---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import releases from '../data/releases.json';
---

<BaseLayout
  title="Getting Started with Lirune Reader — Windows & Android Guide"
  description="Step-by-step onboarding walkthrough for setting up your personal digital library in Lirune Reader on Windows and Android."
  canonicalPath="/getting-started"
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="section-header">
      <span class="badge badge-success">Onboarding Guide</span>
      <h1>Getting Started with Lirune</h1>
      <p>A quick walkthrough to help you set up your offline library, import digital documents, and personalize your reading environment.</p>
    </div>

    <!-- Platform Selector Tabs -->
    <div class="tabs-container">
      <div class="tabs-nav" role="tablist" aria-label="Platform Setup Guides">
        <button
          type="button"
          class="tab-btn active"
          role="tab"
          id="tab-windows"
          aria-selected="true"
          aria-controls="panel-windows"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
          </svg>
          <span>Windows Guide</span>
        </button>
        <button
          type="button"
          class="tab-btn"
          role="tab"
          id="tab-android"
          aria-selected="false"
          aria-controls="panel-android"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-1.0003s.4482-1.0003.9993-1.0003c.5516 0 .9998.4486.9998 1.0003s-.4482 1.0003-.9998 1.0003m-11.046 0c-.5511 0-.9993-.4486-.9993-1.0003s.4482-1.0003.9993-1.0003c.5516 0 .9998.4486.9998 1.0003s-.4482 1.0003-.9998 1.0003m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.084 12 8.084c-1.8533 0-3.5902.3276-5.1378.8657L4.84 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.152 5.676l1.9972 3.4592C2.6889 16.275 0 20.443 0 25.3333h24c0-4.8903-2.689-9.0583-6.1185-16.0119"/>
          </svg>
          <span>Android Guide</span>
        </button>
      </div>

      <!-- Windows Walkthrough Panel -->
      <div class="tab-panel active" id="panel-windows" role="tabpanel" aria-labelledby="tab-windows">
        <section class="guide-step surface-card">
          <div class="step-badge">Step 1</div>
          <div class="step-content">
            <h2>Install Lirune on Windows</h2>
            <p>
              Install directly from the <strong>Microsoft Store</strong> (recommended for automatic seamless updates) or download the standalone <code>{releases.windows.installerFilename}</code> installer.
            </p>
            <div class="guide-actions">
              <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                <span>Microsoft Store Listing ↗</span>
              </a>
              <a href={releases.windows.installerUrl} class="btn btn-secondary">
                <span>Download Installer (.exe)</span>
              </a>
            </div>
          </div>
        </section>

        <section class="guide-step surface-card">
          <div class="step-badge">Step 2</div>
          <div class="step-content">
            <h2>Add your ebooks and documents</h2>
            <p>
              Lirune does not copy your original book files into a hidden proprietary vault. You can:
            </p>
            <ul class="guide-bullets" role="list">
              <li><strong>Drag and drop</strong> any supported file (e.g. <code>.epub</code>, <code>.pdf</code>, <code>.cbz</code>) directly onto the Lirune window.</li>
              <li>Click the <strong>Add Book</strong> button in the top toolbar to browse your local filesystem.</li>
            </ul>
            <p>
              Cover images, titles, and author metadata are extracted and stored locally in your SQLite library database.
            </p>
          </div>
        </section>

        <section class="guide-step surface-card">
          <div class="step-badge">Step 3</div>
          <div class="step-content">
            <h2>Customize your reading environment</h2>
            <p>
              Open any book to enter reading view. Click the gear icon or press <kbd>Ctrl+,</kbd> to open reading settings:
            </p>
            <ul class="guide-bullets" role="list">
              <li>Switch between <strong>Two-Page Spread</strong> and <strong>Single-Column Flow</strong>.</li>
              <li>Toggle between <strong>Obsidian Dark</strong>, <strong>Paper Cream</strong>, and <strong>Sepia</strong> themes.</li>
              <li>Press <kbd>F11</kbd> for distraction-free fullscreen reading.</li>
            </ul>
          </div>
        </section>
      </div>

      <!-- Android Walkthrough Panel -->
      <div class="tab-panel" id="panel-android" role="tabpanel" aria-labelledby="tab-android" hidden>
        <section class="guide-step surface-card">
          <div class="step-badge">Step 1</div>
          <div class="step-content">
            <h2>Install the Android APK</h2>
            <p>
              Download <code>{releases.android.apkFilename}</code> directly to your Android device from GitHub Releases.
            </p>
            <p>
              If your browser asks for permission to install apps, enable "Allow from this source" in your Android system settings.
            </p>
            <div class="guide-actions">
              <a href={releases.android.apkUrl} class="btn btn-primary">
                <span>Download Android APK</span>
              </a>
            </div>
          </div>
        </section>

        <section class="guide-step surface-card">
          <div class="step-badge">Step 2</div>
          <div class="step-content">
            <h2>Grant Storage Access Framework (SAF) folder permission</h2>
            <p>
              Because Lirune requests zero invasive permissions, it uses Google's standard <strong>Storage Access Framework</strong>:
            </p>
            <ul class="guide-bullets" role="list">
              <li>Tap <strong>Select Folder</strong> when opening the library.</li>
              <li>Choose your device's <code>Books</code>, <code>Documents</code>, or <code>Download</code> folder.</li>
              <li>Tap <strong>Use this folder</strong> to let Lirune read files within that directory.</li>
            </ul>
          </div>
        </section>

        <section class="guide-step surface-card">
          <div class="step-badge">Step 3</div>
          <div class="step-content">
            <h2>Enjoy Scroll Engine v2 & Offline TTS</h2>
            <p>
              Tap any book cover to start reading. Tap the center of the screen to reveal the bottom reading toolbar:
            </p>
            <ul class="guide-bullets" role="list">
              <li>Adjust font size, margins, and line height to match your screen size.</li>
              <li>Tap the <strong>Headphones</strong> icon to activate offline Text-to-Speech audio narration.</li>
              <li>Close the app or lock your screen: playback continues in the background.</li>
            </ul>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tabs-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .tabs-nav {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    border-bottom: 1px solid var(--border-default);
    padding-bottom: var(--sp-2);
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 10px 18px;
    border-radius: var(--r-md);
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .tab-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
  }

  .tab-btn.active {
    color: var(--accent);
    background-color: var(--accent-subtle);
  }

  .tab-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .tab-panel[hidden] {
    display: none;
  }

  .guide-step {
    padding: clamp(24px, 4vw, 36px);
    display: flex;
    gap: var(--sp-6);
    align-items: flex-start;
  }

  .step-badge {
    padding: 4px 10px;
    border-radius: var(--r-sm);
    background-color: var(--accent-chrome-subtle);
    border: 1px solid var(--border-accent);
    color: var(--accent-chrome);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .step-content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .step-content h2 {
    font-size: 1.35rem;
  }

  .step-content p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .guide-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 4px;
  }

  .guide-bullets li {
    position: relative;
    padding-left: 20px;
    font-size: 0.94rem;
    color: var(--text-secondary);
  }

  .guide-bullets li::before {
    content: "•";
    position: absolute;
    left: 4px;
    top: 0;
    color: var(--accent-chrome);
  }

  .guide-bullets strong {
    color: var(--text-primary);
  }

  .guide-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
    flex-wrap: wrap;
  }

  kbd {
    display: inline-block;
    padding: 2px 6px;
    border-radius: var(--r-sm);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-default);
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--text-primary);
  }
</style>

<script>
  function setupGuideTabs() {
    const tabWindows = document.getElementById('tab-windows') as HTMLButtonElement | null;
    const tabAndroid = document.getElementById('tab-android') as HTMLButtonElement | null;
    const panelWindows = document.getElementById('panel-windows');
    const panelAndroid = document.getElementById('panel-android');

    function switchTab(target: 'windows' | 'android') {
      if (target === 'windows') {
        tabWindows?.classList.add('active');
        tabWindows?.setAttribute('aria-selected', 'true');
        tabAndroid?.classList.remove('active');
        tabAndroid?.setAttribute('aria-selected', 'false');

        if (panelWindows) panelWindows.hidden = false;
        if (panelAndroid) panelAndroid.hidden = true;
      } else {
        tabAndroid?.classList.add('active');
        tabAndroid?.setAttribute('aria-selected', 'true');
        tabWindows?.classList.remove('active');
        tabWindows?.setAttribute('aria-selected', 'false');

        if (panelAndroid) panelAndroid.hidden = false;
        if (panelWindows) panelWindows.hidden = true;
      }
    }

    tabWindows?.addEventListener('click', () => switchTab('windows'));
    tabAndroid?.addEventListener('click', () => switchTab('android'));
  }

  setupGuideTabs();
  document.addEventListener('astro:page-load', setupGuideTabs);
</script>
