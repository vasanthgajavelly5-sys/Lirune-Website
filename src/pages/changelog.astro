---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import releases from '../data/releases.json';
---

<BaseLayout
  title="What's New & Release Changelog — Lirune Reader"
  description="Chronological release notes and security improvements for Lirune Reader on Windows and Android."
  canonicalPath="/changelog"
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="section-header">
      <span class="badge badge-success">Release History</span>
      <h1>Changelog & Milestones</h1>
      <p>Tracking release versions, security hardening, and feature improvements across Windows and Android channels.</p>
    </div>

    <div class="changelog-timeline">
      <!-- Release 1: Windows 5.6.2 -->
      <article class="timeline-item">
        <div class="timeline-dot-wrap">
          <span class="timeline-dot windows"></span>
        </div>
        <div class="timeline-content surface-card">
          <div class="timeline-header">
            <div>
              <div class="timeline-tags">
                <span class="platform-tag windows">Windows</span>
                <span class="version-tag">v{releases.windows.version}</span>
                <span class="badge badge-success">Latest Stable</span>
              </div>
              <h2 class="timeline-title">{releases.windows.name}</h2>
            </div>
            <time class="timeline-date">{releases.windows.releaseDate}</time>
          </div>

          <div class="timeline-body">
            <h3>Highlights & Fixes</h3>
            <ul class="changelog-list" role="list">
              {releases.windows.highlights.map(h => (
                <li>{h}</li>
              ))}
            </ul>

            <div class="timeline-actions">
              <a href={releases.windows.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <span>View on GitHub ↗</span>
              </a>
              <a href={releases.windows.installerUrl} class="btn btn-subtle">
                <span>Download Installer ({releases.windows.installerFilename})</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- Release 2: Android 4.9.3 -->
      <article class="timeline-item">
        <div class="timeline-dot-wrap">
          <span class="timeline-dot android"></span>
        </div>
        <div class="timeline-content surface-card">
          <div class="timeline-header">
            <div>
              <div class="timeline-tags">
                <span class="platform-tag android">Android</span>
                <span class="version-tag">v{releases.android.version}</span>
                <span class="badge badge-success">Latest Stable</span>
              </div>
              <h2 class="timeline-title">{releases.android.name}</h2>
            </div>
            <time class="timeline-date">{releases.android.releaseDate}</time>
          </div>

          <div class="timeline-body">
            <h3>Highlights & Fixes</h3>
            <ul class="changelog-list" role="list">
              {releases.android.highlights.map(h => (
                <li>{h}</li>
              ))}
            </ul>

            <div class="timeline-actions">
              <a href={releases.android.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <span>View on GitHub ↗</span>
              </a>
              <a href={releases.android.apkUrl} class="btn btn-subtle">
                <span>Download Release APK ({releases.android.apkFilename})</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- Milestone Archive: Windows 5.6.0 -->
      <article class="timeline-item">
        <div class="timeline-dot-wrap">
          <span class="timeline-dot"></span>
        </div>
        <div class="timeline-content surface-card">
          <div class="timeline-header">
            <div>
              <div class="timeline-tags">
                <span class="platform-tag windows">Windows</span>
                <span class="version-tag">v5.6.0</span>
              </div>
              <h2 class="timeline-title">PDF.js Integration & Zip-Slip Protection</h2>
            </div>
            <time class="timeline-date">2026-10-15</time>
          </div>
          <div class="timeline-body">
            <ul class="changelog-list" role="list">
              <li>Integrated native offline PDF.js viewer with page thumbnail preview drawer.</li>
              <li>Enforced Zip-Slip archive path-traversal validation for EPUB and CBZ files.</li>
              <li>Implemented 512 MB file bounds check to protect against decompression memory bombs.</li>
            </ul>
          </div>
        </div>
      </article>

      <!-- Milestone Archive: Android 4.9.0 -->
      <article class="timeline-item">
        <div class="timeline-dot-wrap">
          <span class="timeline-dot"></span>
        </div>
        <div class="timeline-content surface-card">
          <div class="timeline-header">
            <div>
              <div class="timeline-tags">
                <span class="platform-tag android">Android</span>
                <span class="version-tag">v4.9.0</span>
              </div>
              <h2 class="timeline-title">Scroll Engine v2 Virtualization & TTS Audio Player</h2>
            </div>
            <time class="timeline-date">2026-10-12</time>
          </div>
          <div class="timeline-body">
            <ul class="changelog-list" role="list">
              <li>Introduced Scroll Engine v2 virtualizing large book chapters to sustain 60fps vertical flow.</li>
              <li>Added offline Text-to-Speech audio player with speech rate modulation and background service.</li>
              <li>Integrated Android Storage Access Framework (SAF) folder picker.</li>
            </ul>
          </div>
        </div>
      </article>
    </div>

    <div class="changelog-footer-card surface-card text-center">
      <h3>Looking for older historical releases?</h3>
      <p>Browse all past git tags, source code snapshots, and historical assets directly on GitHub.</p>
      <a href={config.githubReleases} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        <span>Browse GitHub Releases Archive ↗</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .changelog-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    margin-bottom: var(--sp-12);
  }

  .changelog-timeline::before {
    content: "";
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 19px;
    width: 2px;
    background-color: var(--border-default);
    z-index: 1;
  }

  .timeline-item {
    position: relative;
    display: flex;
    gap: var(--sp-6);
    z-index: 2;
  }

  .timeline-dot-wrap {
    width: 40px;
    display: flex;
    justify-content: center;
    padding-top: var(--sp-6);
    flex-shrink: 0;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--bg-surface);
    border: 3px solid var(--border-strong);
    box-shadow: 0 0 0 4px var(--bg-base);
  }

  .timeline-dot.windows {
    border-color: var(--color-windows);
  }

  .timeline-dot.android {
    border-color: var(--color-android);
  }

  .timeline-content {
    flex: 1 1 auto;
    padding: clamp(24px, 4vw, 36px);
  }

  .timeline-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--sp-4);
  }

  @media (min-width: 640px) {
    .timeline-header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .timeline-tags {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .platform-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--r-sm);
  }

  .platform-tag.windows {
    background-color: rgba(0, 120, 215, 0.15);
    color: var(--color-windows);
  }

  .platform-tag.android {
    background-color: rgba(61, 220, 132, 0.15);
    color: var(--color-android);
  }

  .version-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .timeline-title {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .timeline-body h3 {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    margin-bottom: var(--sp-3);
  }

  .changelog-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: var(--sp-6);
  }

  .changelog-list li {
    position: relative;
    padding-left: 20px;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .changelog-list li::before {
    content: "•";
    position: absolute;
    left: 4px;
    top: 0;
    color: var(--accent-chrome);
    font-size: 1.2rem;
    line-height: 1;
  }

  .timeline-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .changelog-footer-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .changelog-footer-card h3 {
    font-size: 1.2rem;
  }

  .changelog-footer-card p {
    color: var(--text-secondary);
    max-width: 520px;
  }
</style>
