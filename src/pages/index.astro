---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import releases from '../data/releases.json';
import formats from '../data/formats.json';
---

<BaseLayout
  title="Lirune Reader — A calm, private home for your library on Windows and Android"
  description="Lirune is a free, open-source, offline ebook and document reader for Windows and Android. 50+ formats supported with zero telemetry and total privacy."
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="site-container hero-inner">
      <div class="hero-copy">
        <div class="hero-badge-strip">
          <span class="hero-badge">
            <span class="badge-dot"></span> Offline-First Document Reader
          </span>
          <span class="hero-badge hero-badge-secondary">GPL-3.0 Open Source</span>
        </div>

        <h1 class="hero-title">
          A calm, private sanctuary for your digital library.
        </h1>

        <p class="hero-subtitle">
          Designed specifically for reading on <strong>Windows</strong> and <strong>Android</strong>. Read EPUB, PDF, comic books, and 16 other formats completely offline with zero telemetry, local indexation, and true device ownership.
        </p>

        <div class="hero-actions">
          <a href="/downloads" class="btn btn-primary btn-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Get Lirune Free</span>
          </a>

          <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
            </svg>
            <span>Microsoft Store</span>
          </a>

          <a href="/features" class="btn btn-subtle btn-lg">
            <span>Explore features →</span>
          </a>
        </div>

        <div class="hero-meta-strip">
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Windows v{releases.windows.version} (Store & Installer)</span>
          </div>
          <div class="hero-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Android v{releases.android.version} (Zero-permission APK)</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Composition (Real Screenshots in Device Frames) -->
      <div class="hero-showcase">
        <!-- Desktop Monitor Mockup -->
        <div class="device-frame-desktop hero-desktop-frame clickable-shot"
             data-shot-src="/images/screenshots/win-library-grid.png"
             data-shot-title="Windows Library Grid View"
             data-shot-platform="Windows"
             data-shot-caption="Lirune Reader for Windows showcasing the personal digital library in high-resolution grid mode.">
          <div class="device-header-desktop">
            <div class="device-dots">
              <span class="device-dot"></span>
              <span class="device-dot"></span>
              <span class="device-dot"></span>
            </div>
            <span class="device-title">Lirune Reader — Windows 11</span>
            <span style="width: 32px"></span>
          </div>
          <img
            src="/images/screenshots/win-library-grid.png"
            alt="Lirune Reader for Windows displaying digital book library grid"
            width="1280"
            height="800"
            class="device-img"
            loading="eager"
          />
        </div>

        <!-- Floating Mobile Smartphone Mockup -->
        <div class="device-frame-mobile hero-mobile-frame clickable-shot"
             data-shot-src="/images/screenshots/android-reader-epub.png"
             data-shot-title="Android Scroll Engine v2 Reading"
             data-shot-platform="Android"
             data-shot-caption="Lirune Reader for Android running Scroll Engine v2 with refined typography and zero telemetry.">
          <div class="device-notch-mobile"></div>
          <img
            src="/images/screenshots/android-reader-epub.png"
            alt="Lirune Reader for Android reading an EPUB ebook with Scroll Engine v2"
            width="400"
            height="820"
            class="device-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Value Differentiators Strip -->
  <section class="value-strip section-spacing--dense">
    <div class="site-container">
      <div class="value-grid">
        <div class="value-col">
          <div class="value-header">
            <span class="value-num">01</span>
            <h2 class="value-title">Offline by Design</h2>
          </div>
          <p class="value-text">
            No accounts, no cloud sync lock-in, and zero telemetry. On Android, network permission is permanently removed from production builds.
          </p>
        </div>

        <div class="value-col" data-reveal>
          <div class="value-header">
            <span class="value-num">02</span>
            <h2 class="value-title">50+ Formats Supported</h2>
          </div>
          <p class="value-text">
            Read EPUB, PDF, CBZ/CBR comics, FB2 fiction, MOBI, Office documents, spreadsheets, presentations, and images through specialized, hardened local rendering engines.
          </p>
        </div>

        <div class="value-col">
          <div class="value-header">
            <span class="value-num">03</span>
            <h2 class="value-title">Tailored Reading UI</h2>
          </div>
          <p class="value-text">
            Windows dual-page spreads, Android Scroll Engine v2 continuous flow, offline Text-to-Speech narration, and comprehensive typography tuning.
          </p>
        </div>

        <div class="value-col">
          <div class="value-header">
            <span class="value-num">04</span>
            <h2 class="value-title">Free & Open Source</h2>
          </div>
          <p class="value-text">
            Published under the GNU General Public License v3.0. Inspect the source code, verify privacy guarantees, or build your own binaries.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual-Platform Experience Showcase (Asymmetric Editorial Section) -->
  <section class="platform-showcase-section section-spacing">
    <div class="site-container">
      <div class="section-header section-header--center">
        <h2>Designed with respect for both platforms</h2>
        <p>Built as dedicated applications that embrace the unique strengths of Windows desktop and Android mobile.</p>
      </div>

      <!-- Windows Experience Row -->
      <div class="showcase-split-row">
        <div class="showcase-visual">
          <div class="device-frame-desktop clickable-shot"
               data-shot-src="/images/screenshots/win-reader-epub-spread.png"
               data-shot-title="Windows Dual-Page Spread View"
               data-shot-platform="Windows"
               data-shot-caption="Dual-page book spread in Lirune Reader Windows, providing an authentic hardbound book reading feel.">
            <div class="device-header-desktop">
              <div class="device-dots">
                <span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span>
              </div>
              <span class="device-title">Windows — Two-Page Spread</span>
              <span style="width: 32px"></span>
            </div>
            <img
              src="/images/screenshots/win-reader-epub-spread.png"
              alt="Windows Dual-page book spread reading view in Lirune Reader"
              width="1080"
              height="675"
              class="device-img"
              loading="lazy"
            />
          </div>
        </div>
        <div class="showcase-copy">
          <span class="showcase-eyebrow windows">Windows 10 & 11 Experience</span>
          <h3 class="showcase-heading">Dual-page spreads and distraction-free desktop immersion</h3>
          <p class="showcase-desc">
            Experience literature on large desktop displays just like a real hardbound volume. Lirune automatically calculates aspect ratios for seamless dual-page book spreads or single-column continuous scroll.
          </p>
          <ul class="showcase-bullets" role="list">
            <li>Auto-hiding navigation chrome and fullscreen reading mode (F11)</li>
            <li>Instant full-text search with preview snippets and page jumps</li>
            <li>Integrated PDF.js high-fidelity document viewer with thumbnail drawer</li>
            <li>Customizable keyboard shortcuts for rapid page turning and navigation</li>
          </ul>
          <div class="showcase-actions">
            <a href="/downloads" class="btn btn-secondary">
              <span>Windows download options</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Android Experience Row -->
      <div class="showcase-split-row showcase-split-row--reverse">
        <div class="showcase-visual">
          <div class="device-frame-mobile clickable-shot"
               data-shot-src="/images/screenshots/android-tts-player.png"
               data-shot-title="Android Offline TTS Narration"
               data-shot-platform="Android"
               data-shot-caption="Lirune Reader for Android offline Text-to-Speech narration player with voice rate and playback controls.">
            <div class="device-notch-mobile"></div>
            <img
              src="/images/screenshots/android-tts-player.png"
              alt="Android Text-to-Speech narration player in Lirune Reader"
              width="400"
              height="820"
              class="device-img"
              loading="lazy"
            />
          </div>
        </div>
        <div class="showcase-copy">
          <span class="showcase-eyebrow android">Android 8.0+ Experience</span>
          <h3 class="showcase-heading">Scroll Engine v2 and offline audio narration</h3>
          <p class="showcase-desc">
            Engineered for one-handed mobile reading on the go. Scroll Engine v2 virtualizes document chapters to deliver unified 60fps continuous scrolling with zero stutter, even on multi-thousand-page volumes.
          </p>
          <ul class="showcase-bullets" role="list">
            <li>Offline Text-to-Speech (TTS) voice narration with background playback</li>
            <li>Storage Access Framework (SAF) integration for direct folder access</li>
            <li>Quick bottom control bar for instant font size, margin, and brightness tuning</li>
            <li>Zero internet permissions: battery-friendly and completely private</li>
          </ul>
          <div class="showcase-actions">
            <a href="/downloads" class="btn btn-secondary">
              <span>Android release APK</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Screenshot Gallery Preview Strip -->
  <section class="gallery-preview-section section-spacing">
    <div class="site-container">
      <div class="section-header">
        <h2>Genuine running interface gallery</h2>
        <p>Real unedited captures from the running Windows and Android applications.</p>
      </div>

      <div class="gallery-strip-grid">
        <div class="gallery-card clickable-shot"
             data-shot-src="/images/screenshots/win-reader-pdf.png"
             data-shot-title="PDF Document Viewer"
             data-shot-platform="Windows"
             data-shot-caption="High-fidelity PDF document rendering in Lirune Reader Windows with sidebar thumbnail drawer.">
          <img src="/images/screenshots/win-reader-pdf.png" alt="PDF reader interface" width="600" height="375" loading="lazy" />
          <div class="gallery-card-meta">
            <span class="gallery-tag">Windows</span>
            <span class="gallery-name">PDF High-Fidelity Viewer</span>
          </div>
        </div>

        <div class="gallery-card clickable-shot"
             data-shot-src="/images/screenshots/win-reader-story.png"
             data-shot-title="FB2 Fiction Story Mode"
             data-shot-platform="Windows"
             data-shot-caption="FB2 fiction story mode with strict DOMPurify HTML sanitization and bookish typography.">
          <img src="/images/screenshots/win-reader-story.png" alt="FB2 fiction reader" width="600" height="375" loading="lazy" />
          <div class="gallery-card-meta">
            <span class="gallery-tag">Windows</span>
            <span class="gallery-name">FB2 Fiction Story Mode</span>
          </div>
        </div>

        <div class="gallery-card clickable-shot"
             data-shot-src="/images/screenshots/android-reader-controls.png"
             data-shot-title="Android Quick Reading Controls"
             data-shot-platform="Android"
             data-shot-caption="Quick bottom reading controls drawer in Android for font size, line height, and theme selection.">
          <img src="/images/screenshots/android-reader-controls.png" alt="Android reading controls drawer" width="600" height="375" loading="lazy" />
          <div class="gallery-card-meta">
            <span class="gallery-tag">Android</span>
            <span class="gallery-name">Quick Reading Controls</span>
          </div>
        </div>

        <div class="gallery-card clickable-shot"
             data-shot-src="/images/screenshots/win-reader-annotations.png"
             data-shot-title="Annotations & Bookmarks Drawer"
             data-shot-platform="Windows"
             data-shot-caption="Windows annotations drawer managing reading progress, highlights, and custom book notes.">
          <img src="/images/screenshots/win-reader-annotations.png" alt="Annotations and notes drawer" width="600" height="375" loading="lazy" />
          <div class="gallery-card-meta">
            <span class="gallery-tag">Windows</span>
            <span class="gallery-name">Annotations & Bookmarks</span>
          </div>
        </div>
      </div>

      <div class="gallery-cta-wrap">
        <a href="/screenshots" class="btn btn-secondary">
          <span>View all 26 application screenshots →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Supported Formats Highlights Strip -->
  <section class="formats-preview-section section-spacing--dense">
    <div class="site-container">
      <div class="formats-preview-box">
        <div class="formats-preview-header" data-reveal>
          <div>
            <span class="badge badge-success">Local Rendering</span>
            <h2 class="formats-title">50+ Formats Supported</h2>
            <p class="formats-desc">Read ebooks, documents, presentations, comics and images in one private, offline-first reader. Zero external servers.</p>
          </div>
          <a href="/formats" class="btn btn-secondary">
            <span>Explore Compatibility Matrix (50+) →</span>
          </a>
        </div>

        <div class="format-badges-grid">
          {formats.slice(0, 12).map(f => (
            <div class="format-badge-item">
              <span class="format-ext">{f.extensions[0].replace('.', '').toUpperCase()}</span>
              <span class="format-name">{f.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy Manifesto Section -->
  <section class="privacy-manifesto-section section-spacing">
    <div class="site-container site-container--narrow">
      <div class="privacy-box">
        <div class="privacy-icon-badge">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h2 class="privacy-title">Your books remain entirely yours.</h2>
        <p class="privacy-text">
          Many modern reading apps have turned into digital storefronts that track reading speed, log page turns, and harvest personal libraries.
        </p>
        <p class="privacy-text">
          Lirune was built on a different principle: <strong>digital reading should be quiet, local, and private</strong>. All metadata, bookmarks, annotations, and library records are stored exclusively in local SQLite or JSON files on your own filesystem. No remote accounts, no tracking beacons, and no data mining.
        </p>
        <div class="privacy-actions">
          <a href="/privacy" class="btn btn-subtle">
            <span>Read full Privacy Architecture →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="final-cta-section section-spacing">
    <div class="site-container site-container--narrow text-center">
      <h2 class="final-cta-title">Ready for a calm, private reading home?</h2>
      <p class="final-cta-desc">
        Download Lirune Reader today for Windows or Android. Free, open-source, and offline forever.
      </p>
      <div class="final-cta-actions">
        <a href="/downloads" class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Get Latest Downloads</span>
        </a>
        <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
          <span>Microsoft Store ↗</span>
        </a>
        <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="btn btn-subtle btn-lg">
          <span>Inspect GitHub Code ↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =============================================================
     HERO SECTION
     ============================================================= */
  .hero-section {
    padding-top: clamp(48px, 6vw, 84px);
    padding-bottom: clamp(64px, 8vw, 112px);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 72px);
  }

  .hero-copy {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge-strip {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--r-full);
    background-color: var(--accent-chrome-subtle);
    color: var(--accent-chrome);
    border: 1px solid var(--border-accent);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .hero-badge-secondary {
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    border-color: var(--border-default);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
  }

  .hero-title {
    margin-bottom: var(--sp-4);
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.28rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--sp-8);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-6);
  }

  .btn-lg {
    padding: 14px 26px;
    font-size: 1rem;
    border-radius: var(--r-md);
  }

  .hero-meta-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-6);
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Hero Showcase Visual */
  .hero-showcase {
    position: relative;
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .hero-desktop-frame {
    width: 100%;
    cursor: pointer;
  }

  .hero-mobile-frame {
    position: absolute;
    bottom: -32px;
    right: 24px;
    width: clamp(180px, 24vw, 260px);
    cursor: pointer;
    z-index: 10;
  }

  @media (max-width: 640px) {
    .hero-mobile-frame {
      display: none;
    }
  }

  /* =============================================================
     VALUE STRIP (01, 02, 03, 04)
     ============================================================= */
  .value-strip {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(24px, 4vw, 40px);
  }

  .value-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .value-header {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .value-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-chrome);
  }

  .value-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .value-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* =============================================================
     PLATFORM SHOWCASE ASYMMETRIC ROWS
     ============================================================= */
  .showcase-split-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-bottom: clamp(64px, 8vw, 100px);
  }

  @media (min-width: 900px) {
    .showcase-split-row {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .showcase-split-row--reverse {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .showcase-split-row--reverse .showcase-visual {
      order: 2;
    }
    .showcase-split-row--reverse .showcase-copy {
      order: 1;
    }
  }

  .showcase-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-2);
  }

  .showcase-eyebrow.windows { color: var(--color-windows); }
  .showcase-eyebrow.android { color: var(--color-android); }

  .showcase-heading {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    margin-bottom: var(--sp-4);
  }

  .showcase-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--sp-6);
  }

  .showcase-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: var(--sp-6);
  }

  .showcase-bullets li {
    position: relative;
    padding-left: 24px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .showcase-bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--status-success);
    font-weight: 700;
  }

  /* =============================================================
     GALLERY PREVIEW STRIP
     ============================================================= */
  .gallery-strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-6);
    margin-bottom: var(--sp-8);
  }

  .gallery-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    overflow: hidden;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all var(--t-fast);
  }

  .gallery-card:hover {
    border-color: var(--border-default);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .gallery-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--border-subtle);
  }

  .gallery-card-meta {
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .gallery-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--r-sm);
    background-color: var(--accent-chrome-subtle);
    color: var(--accent);
  }

  .gallery-name {
    font-size: 0.9rem;
