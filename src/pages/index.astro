---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureSection from '../components/FeatureSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import DownloaderAnnouncement from '../components/DownloaderAnnouncement.astro';
import config from '../data/config.json';
import releases from '../data/releases.json';
import formats from '../data/formats.json';
---

<BaseLayout
  title="Lirune Reader — A calm, private home for your library on Windows and Android"
  description="Lirune Reader is a free, open-source, offline-first ebook and document reader for Windows and Android. Supports 50+ formats with zero telemetry and total privacy."
  canonicalPath="/"
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Editorial Value Differentiators Strip -->
  <section class="value-strip section-spacing--dense" aria-label="Key Pillars">
    <div class="site-container">
      <div class="value-grid">
        <div class="value-col" data-reveal>
          <div class="value-header">
            <span class="value-num">01</span>
            <h2 class="value-title">Offline by Design</h2>
          </div>
          <p class="value-text">
            No accounts, no cloud sync lock-in, and zero telemetry. On Android, network permission is permanently removed from production builds.
          </p>
        </div>

        <div class="value-col" data-reveal>
          <div class="value-header">
            <span class="value-num">02</span>
            <h2 class="value-title">50+ Formats Supported</h2>
          </div>
          <p class="value-text">
            Read EPUB, PDF, CBZ/CBR comics, FB2 fiction, MOBI, Office documents, spreadsheets, presentations, and images through specialized local engines.
          </p>
        </div>

        <div class="value-col" data-reveal>
          <div class="value-header">
            <span class="value-num">03</span>
            <h2 class="value-title">Tailored Reading UI</h2>
          </div>
          <p class="value-text">
            Windows dual-page spreads, Android Scroll Engine v2 continuous flow, offline Text-to-Speech narration, and comprehensive typography tuning.
          </p>
        </div>

        <div class="value-col" data-reveal>
          <div class="value-header">
            <span class="value-num">04</span>
            <h2 class="value-title">Free & Open Source</h2>
          </div>
          <p class="value-text">
            Published under GNU General Public License v3.0. Inspect the source code, verify privacy guarantees, or build your own binaries.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6-Feature Core Cards Grid Section -->
  <FeatureSection />

  <!-- Dual-Platform Experience Showcase (Asymmetric Editorial Section) -->
  <section class="platform-showcase-section section-spacing" aria-label="Platform Highlights">
    <div class="site-container">
      <div class="section-header section-header--center" data-reveal>
        <span class="badge badge-accent">Platform Native Experience</span>
        <h2>Designed with respect for both platforms</h2>
        <p>Built as dedicated applications that embrace the unique ergonomics of Windows desktop and Android mobile.</p>
      </div>

      <!-- Windows Experience Row -->
      <div class="showcase-split-row" data-reveal>
        <div class="showcase-visual">
          <div class="device-frame-desktop">
            <div class="device-header-desktop">
              <div class="device-dots">
                <span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span>
              </div>
              <span class="device-title">Windows — Two-Page Spread</span>
              <span class="device-tag">Desktop</span>
            </div>
            <img
              src="/images/screenshots/win-reader-epub-spread.png"
              alt="Windows Dual-page book spread reading view in Lirune Reader"
              width="1080"
              height="675"
              class="device-img"
              loading="lazy"
            />
          </div>
        </div>
        <div class="showcase-copy">
          <span class="showcase-eyebrow windows">Windows 10 & 11 Experience</span>
          <h3 class="showcase-heading">Dual-page spreads and distraction-free desktop immersion</h3>
          <p class="showcase-desc">
            Experience literature on large desktop displays just like a real hardbound volume. Lirune automatically calculates aspect ratios for seamless dual-page book spreads or single-column continuous scroll.
          </p>
          <ul class="showcase-bullets" role="list">
            <li>Auto-hiding navigation chrome and fullscreen reading mode (F11)</li>
            <li>Instant full-text search with preview snippets and page jumps</li>
            <li>Integrated PDF.js high-fidelity document viewer with thumbnail drawer</li>
            <li>Customizable keyboard shortcuts for rapid page turning and navigation</li>
          </ul>
          <div class="showcase-actions">
            <a href="/downloads" class="btn btn-primary">
              <span>Windows download options</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Android Experience Row -->
      <div class="showcase-split-row showcase-split-row--reverse" data-reveal>
        <div class="showcase-visual">
          <div class="device-frame-mobile">
            <div class="device-notch-mobile"></div>
            <img
              src="/images/screenshots/android-tts-player.png"
              alt="Android Text-to-Speech narration player in Lirune Reader"
              width="400"
              height="820"
              class="device-img"
              loading="lazy"
            />
          </div>
        </div>
        <div class="showcase-copy">
          <span class="showcase-eyebrow android">Android 8.0+ Experience</span>
          <h3 class="showcase-heading">Scroll Engine v2 and offline audio narration</h3>
          <p class="showcase-desc">
            Engineered for one-handed mobile reading on the go. Scroll Engine v2 virtualizes document chapters to deliver unified 60fps continuous scrolling with zero stutter, even on multi-thousand-page volumes.
          </p>
          <ul class="showcase-bullets" role="list">
            <li>Offline Text-to-Speech (TTS) voice narration with background playback</li>
            <li>Storage Access Framework (SAF) integration for direct folder access</li>
            <li>Quick bottom control bar for instant font size, margin, and brightness tuning</li>
            <li>Zero internet permissions: battery-friendly and completely private</li>
          </ul>
          <div class="showcase-actions">
            <a href="/downloads" class="btn btn-primary">
              <span>Android release APK</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Formats Highlights Strip -->
  <section class="formats-preview-section section-spacing--dense" aria-label="Format Highlights">
    <div class="site-container">
      <div class="formats-preview-box" data-reveal>
        <div class="formats-preview-header">
          <div>
            <span class="badge badge-success">Local Rendering</span>
            <h2 class="formats-title">50+ Formats Supported</h2>
            <p class="formats-desc">Read ebooks, documents, presentations, comics and images in one private, offline-first reader. Zero external cloud servers.</p>
          </div>
          <a href="/formats" class="btn btn-secondary">
            <span>Explore Compatibility Matrix (50+) →</span>
          </a>
        </div>

        <div class="format-badges-grid">
          {formats.slice(0, 16).map(f => (
            <div class="format-badge-item">
              <span class="format-ext">{f.extensions[0].replace('.', '').toUpperCase()}</span>
              <span class="format-name">{f.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Reader Testimonials / Social Proof Section -->
  <TestimonialSection />

  <!-- Privacy Manifesto Section -->
  <section class="privacy-manifesto-section section-spacing" aria-label="Privacy Principles">
    <div class="site-container site-container--narrow">
      <div class="privacy-box" data-reveal>
        <div class="privacy-icon-badge" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h2 class="privacy-title">Your books remain entirely yours.</h2>
        <p class="privacy-text">
          Many modern reading apps have turned into digital storefronts that track reading speed, log page turns, and harvest personal libraries.
        </p>
        <p class="privacy-text">
          Lirune was built on a different principle: <strong>digital reading should be quiet, local, and private</strong>. All metadata, bookmarks, annotations, and library records are stored exclusively in local SQLite or JSON files on your own filesystem. No remote accounts, no tracking beacons, and no data mining.
        </p>
        <div class="privacy-actions">
          <a href="/privacy" class="btn btn-subtle">
            <span>Read full Privacy Architecture →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lirune Downloader Announcement (Coming Soon) -->
  <DownloaderAnnouncement />

  <!-- Final CTA Section -->
  <section class="final-cta-section section-spacing" aria-label="Call to Action">
    <div class="site-container site-container--narrow text-center" data-reveal>
      <h2 class="final-cta-title">Ready for a calm, private reading home?</h2>
      <p class="final-cta-desc">
        Download Lirune Reader today for Windows 6.0.0 or Android 5.0.0. Free, open-source, and offline forever.
      </p>
      <div class="final-cta-actions">
        <a href="/downloads" class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Get Latest Downloads</span>
        </a>
        <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
          <span>Microsoft Store ↗</span>
        </a>
        <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="btn btn-subtle btn-lg">
          <span>Inspect GitHub Code ↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =============================================================
     VALUE STRIP (01, 02, 03, 04)
     ============================================================= */
  .value-strip {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(24px, 4vw, 40px);
  }

  .value-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .value-header {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .value-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-chrome);
  }

  .value-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .value-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* =============================================================
     PLATFORM SHOWCASE ASYMMETRIC ROWS
     ============================================================= */
  .showcase-split-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-bottom: clamp(64px, 8vw, 100px);
  }

  @media (min-width: 900px) {
    .showcase-split-row {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .showcase-split-row--reverse {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .showcase-split-row--reverse .showcase-visual {
      order: 2;
    }
    .showcase-split-row--reverse .showcase-copy {
      order: 1;
    }
  }

  .showcase-visual {
    width: 100%;
  }

  .device-frame-desktop {
    width: 100%;
    border-radius: var(--r-lg);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .device-header-desktop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background-color: var(--bg-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .device-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .device-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .device-title {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .device-tag {
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: var(--r-xs);
    background-color: var(--accent-chrome-subtle);
    color: var(--accent-chrome);
    font-weight: 600;
  }

  .device-frame-mobile {
    max-width: 300px;
    margin: 0 auto;
    border-radius: var(--r-2xl);
    background-color: var(--bg-surface);
    border: 2px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    position: relative;
  }

  .device-notch-mobile {
    width: 80px;
    height: 14px;
    background-color: var(--bg-base);
    border-radius: 0 0 10px 10px;
    margin: 0 auto;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 12;
  }

  .device-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .showcase-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-2);
  }

  .showcase-eyebrow.windows { color: var(--color-windows); }
  .showcase-eyebrow.android { color: var(--color-android); }

  .showcase-heading {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    margin-bottom: var(--sp-4);
    line-height: 1.25;
  }

  .showcase-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--sp-6);
  }

  .showcase-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: var(--sp-6);
  }

  .showcase-bullets li {
    position: relative;
    padding-left: 24px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .showcase-bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--status-success);
    font-weight: 700;
  }

  /* =============================================================
     FORMATS PREVIEW BOX
     ============================================================= */
  .formats-preview-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: clamp(32px, 5vw, 48px);
    box-shadow: var(--shadow-md);
  }

  .formats-preview-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 768px) {
    .formats-preview-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .formats-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin-top: var(--sp-2);
    margin-bottom: var(--sp-2);
  }

  .formats-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 60ch;
  }

  .format-badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--sp-3);
  }

  .format-badge-item {
    display: flex;
    flex-direction: column;
    padding: 10px 14px;
    border-radius: var(--r-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    transition: border-color var(--t-fast), background-color var(--t-fast), transform var(--t-fast);
  }

  .format-badge-item:hover {
    border-color: var(--border-strong);
    background-color: var(--bg-hover);
    transform: translateY(-2px);
  }

  .format-ext {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-chrome);
  }

  .format-name {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* =============================================================
     PRIVACY MANIFESTO BOX
     ============================================================= */
  .privacy-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: clamp(32px, 6vw, 56px);
    text-align: center;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .privacy-icon-badge {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--accent-chrome-subtle);
    color: var(--accent-chrome);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .privacy-title {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .privacy-text {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 60ch;
  }

  /* =============================================================
     FINAL CTA
     ============================================================= */
  .text-center {
    text-align: center;
  }

  .final-cta-title {
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    margin-bottom: var(--sp-4);
  }

  .final-cta-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: var(--sp-8);
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
</style>
