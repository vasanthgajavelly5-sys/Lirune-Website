---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
---

<BaseLayout
  title="Features & Capabilities — Lirune Reader"
  description="Explore the offline reading capabilities of Lirune Reader for Windows and Android: dual-page spreads, Scroll Engine v2, offline TTS, and 19 format rendering."
  canonicalPath="/features"
>
  <div class="site-container section-spacing">
    <div class="section-header section-header--center">
      <span class="badge badge-success">Engine & Capabilities</span>
      <h1>Crafted for the art of reading</h1>
      <p>Lirune combines a high-performance offline rendering engine with deliberate, calm design to create the optimal environment for your personal digital library.</p>
    </div>

    <!-- Feature 1: The Reading Engine (Dual Spreads & Scroll Engine v2) -->
    <section class="feature-story-block">
      <div class="feature-story-visual">
        <div class="device-frame-desktop clickable-shot"
             data-shot-src="/images/screenshots/win-reader-epub-spread.png"
             data-shot-title="Windows Two-Page Spread View"
             data-shot-platform="Windows"
             data-shot-caption="Lirune Reader Windows dual-page spread providing authentic bookish reading rhythm on wide displays.">
          <div class="device-header-desktop">
            <div class="device-dots"><span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span></div>
            <span class="device-title">Windows — Spread Reading</span>
            <span style="width: 32px"></span>
          </div>
          <img src="/images/screenshots/win-reader-epub-spread.png" alt="Dual-page book spread reading in Windows" width="1080" height="675" loading="lazy" />
        </div>
      </div>
      <div class="feature-story-copy">
        <div class="feature-num">01 / Engine</div>
        <h2>Dual-Page Spreads and Virtualized Scrolling</h2>
        <p>
          Reading on a wide computer screen should feel like holding an open book, not reading a web document. Lirune calculates aspect ratios automatically to present comfortable two-column spreads with balanced gutters and authentic page turns.
        </p>
        <p>
          On mobile, <strong>Scroll Engine v2</strong> virtualizes chapter DOM nodes to maintain consistent 60fps scrolling across 1,000+ page books while consuming minimal battery and RAM.
        </p>
        <div class="feature-pills">
          <span class="feature-pill">Dual-page spread</span>
          <span class="feature-pill">Continuous vertical flow</span>
          <span class="feature-pill">Scroll Engine v2</span>
          <span class="feature-pill">Fullscreen immersion (F11)</span>
        </div>
      </div>
    </section>

    <!-- Feature 2: Offline Audio Narration (TTS) -->
    <section class="feature-story-block feature-story-block--reverse">
      <div class="feature-story-visual">
        <div class="device-frame-mobile clickable-shot"
             data-shot-src="/images/screenshots/android-tts-player.png"
             data-shot-title="Android Text-to-Speech Player"
             data-shot-platform="Android"
             data-shot-caption="Offline Text-to-Speech audio narration player in Android with background playback and chapter scrubber.">
          <div class="device-notch-mobile"></div>
          <img src="/images/screenshots/android-tts-player.png" alt="Android Text-to-Speech voice narration player" width="400" height="820" loading="lazy" />
        </div>
      </div>
      <div class="feature-story-copy">
        <div class="feature-num">02 / Narration</div>
        <h2>Offline Text-to-Speech audio player</h2>
        <p>
          Turn any supported book or document into an audio experience without connecting to remote speech synthesis APIs. Lirune interfaces directly with your system's offline voice synthesizer.
        </p>
        <p>
          Enjoy background playback while walking or commuting, complete with lock-screen media controls, adjustable speech rates, voice pitch modulation, and chapter position scrubbing.
        </p>
        <div class="feature-pills">
          <span class="feature-pill">Offline system voices</span>
          <span class="feature-pill">Background audio service</span>
          <span class="feature-pill">Speech rate controls</span>
          <span class="feature-pill">Lock-screen integration</span>
        </div>
      </div>
    </section>

    <!-- Feature 3: Navigation, Search & Annotations -->
    <section class="feature-story-block">
      <div class="feature-story-visual">
        <div class="device-frame-desktop clickable-shot"
             data-shot-src="/images/screenshots/win-reader-search.png"
             data-shot-title="Full-Text Search Modal"
             data-shot-platform="Windows"
             data-shot-caption="Windows full-text search finding keyword instances across the entire book with match previews.">
          <div class="device-header-desktop">
            <div class="device-dots"><span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span></div>
            <span class="device-title">Windows — Full-Text Search</span>
            <span style="width: 32px"></span>
          </div>
          <img src="/images/screenshots/win-reader-search.png" alt="Full-text search modal in Lirune Reader" width="1080" height="675" loading="lazy" />
        </div>
      </div>
      <div class="feature-story-copy">
        <div class="feature-num">03 / Discovery</div>
        <h2>Full-text search, TOC drawer & annotations</h2>
        <p>
          Find quotes and references instantly. The built-in search engine indexes book content locally, highlighting exact occurrences and providing context preview snippets so you can jump to chapters in a single click.
        </p>
        <p>
          Organize your reading with a multi-level Table of Contents drawer, persistent bookmarks, and custom notes stored directly in your local library index.
        </p>
        <div class="feature-pills">
          <span class="feature-pill">Contextual search snippets</span>
          <span class="feature-pill">Multi-level TOC</span>
          <span class="feature-pill">Highlights & Notes</span>
          <span class="feature-pill">Reading progress sync</span>
        </div>
      </div>
    </section>

    <!-- Feature 4: Security & Hardening -->
    <section class="feature-story-block feature-story-block--reverse">
      <div class="feature-story-visual">
        <div class="device-frame-desktop clickable-shot"
             data-shot-src="/images/screenshots/win-settings-reading.png"
             data-shot-title="Reading Appearance & Security Controls"
             data-shot-platform="Windows"
             data-shot-caption="Windows application settings demonstrating strict security sanitization, local storage paths, and appearance choices.">
          <div class="device-header-desktop">
            <div class="device-dots"><span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span></div>
            <span class="device-title">Windows — Appearance & Settings</span>
            <span style="width: 32px"></span>
          </div>
          <img src="/images/screenshots/win-reader-toc.png" alt="Table of contents and reading settings" width="1080" height="675" loading="lazy" />
        </div>
      </div>
      <div class="feature-story-copy">
        <div class="feature-num">04 / Security</div>
        <h2>Defense-in-depth document sanitization</h2>
        <p>
          Many ebooks and documents contain embedded HTML, XML scripts, or untrusted archives. Lirune enforces strict defense-in-depth isolation:
        </p>
        <ul class="feature-checklist" role="list">
          <li><strong>DOMPurify HTML Sanitization:</strong> Strips malicious scripts and iframe vectors from FB2, HTML, and Markdown documents.</li>
          <li><strong>Zip-Slip Protection:</strong> Rejects archives attempting path-traversal attacks beyond extract bounds.</li>
          <li><strong>512 MB Bounds Check:</strong> Guards against decompression bombs and denial-of-service memory exhaustion.</li>
          <li><strong>Zero Network Telemetry:</strong> No tracking SDKs, no external analytics pings, no cloud phone-home.</li>
        </ul>
      </div>
    </section>

    <!-- Bottom Action CTA -->
    <div class="features-bottom-cta text-center">
      <h2>Ready to experience Lirune?</h2>
      <p>Download Lirune Reader for Windows or Android and bring calm back to your personal library.</p>
      <div class="features-cta-actions">
        <a href="/downloads" class="btn btn-primary btn-lg">
          <span>Get Latest Downloads</span>
        </a>
        <a href="/formats" class="btn btn-secondary btn-lg">
          <span>View Supported Formats (19)</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .feature-story-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
    margin-bottom: clamp(72px, 10vw, 128px);
  }

  @media (min-width: 900px) {
    .feature-story-block {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .feature-story-block--reverse {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .feature-story-block--reverse .feature-story-visual {
      order: 2;
    }

    .feature-story-block--reverse .feature-story-copy {
      order: 1;
    }
  }

  .feature-num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-chrome);
    letter-spacing: 0.06em;
    margin-bottom: var(--sp-2);
  }

  .feature-story-copy h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    margin-bottom: var(--sp-4);
  }

  .feature-story-copy p {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--sp-4);
  }

  .feature-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }

  .feature-pill {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--r-full);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
  }

  .feature-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: var(--sp-4);
  }

  .feature-checklist li {
    position: relative;
    padding-left: 24px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .feature-checklist li::before {
    content: "🛡️";
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.85rem;
  }

  .feature-checklist strong {
    color: var(--text-primary);
  }

  .features-bottom-cta {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: clamp(40px, 6vw, 64px);
    box-shadow: var(--shadow-md);
  }

  .features-bottom-cta h2 {
    margin-bottom: var(--sp-3);
  }

  .features-bottom-cta p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: var(--sp-6);
    margin-left: auto;
    margin-right: auto;
  }

  .features-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
</style>
