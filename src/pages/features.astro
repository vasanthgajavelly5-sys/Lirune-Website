---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Features & Capabilities — Lirune Reader"
  description="Explore the full capabilities of Lirune Reader for Windows and Android: library management, typography controls, spread layouts, 19 formats, and study annotations."
>
  <div class="features-page">
    <div class="container">
      <div class="page-header text-center">
        <span class="section-label">Feature Directory</span>
        <h1 class="page-title">Every feature, designed for reading</h1>
        <p class="page-subtitle mx-auto">
          Lirune avoids feature bloat and focuses strictly on what makes an ebook reader pleasurable, responsive, and respectful of your data.
        </p>
      </div>

      <!-- Feature 1: Library Management -->
      <section class="feature-block">
        <div class="feature-grid">
          <div class="feature-info">
            <span class="badge badge-accent">Library & Organization</span>
            <h2>A library that stays organized without effort</h2>
            <p>
              Importing books into Lirune doesn't lock you into a proprietary cloud catalog. Lirune inspects your files directly on your device, caches high-resolution cover artwork, and lets you browse however you prefer.
            </p>
            <ul class="feature-check-list">
              <li><strong>Grid and List Views:</strong> Seamlessly toggle between visual book cover cards and detailed metadata list view.</li>
              <li><strong>Custom Collections:</strong> Group books into custom reading lists, categories, or projects.</li>
              <li><strong>Favorites & Queue:</strong> Mark books with a heart to keep your current reading list at top priority.</li>
              <li><strong>Instant Filtering:</strong> Search titles and authors in real-time with zero latency.</li>
            </ul>
          </div>
          <div class="feature-media">
            <div class="device-desktop-frame clickable-shot" data-full="/images/screenshots/win-library-grid.png" data-title="Library Management" data-caption="Library grid with cover art, progress bars, and search">
              <img src="/images/screenshots/win-library-grid.png" alt="Library management screen" width="800" height="500" loading="lazy" />
              <div class="shot-zoom-badge">Click to enlarge</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Feature 2: Reader Layouts & Display -->
      <section class="feature-block">
        <div class="feature-grid reversed">
          <div class="feature-info">
            <span class="badge badge-accent">Reading Engine</span>
            <h2>Spreads, single pages, and continuous scroll</h2>
            <p>
              Different books require different reading flows. Novels often read best in paginated spreads, while technical manuals and articles benefit from smooth continuous scrolling.
            </p>
            <ul class="feature-check-list">
              <li><strong>Two-Page Spread (Auto):</strong> Automatically displays two pages side-by-side on wide desktop displays, just like an open physical book.</li>
              <li><strong>Single Page Paginated:</strong> Clean, centered single page with keyboard or click paging.</li>
              <li><strong>Continuous Flow Scroll:</strong> Virtualized continuous vertical scrolling for effortless reading without artificial page breaks.</li>
              <li><strong>Reading Progress Bar:</strong> Minimalist bottom progress bar indicating current chapter, overall position, and percentage.</li>
            </ul>
          </div>
          <div class="feature-media">
            <div class="device-desktop-frame clickable-shot" data-full="/images/screenshots/win-reader-epub-spread.png" data-title="Two-Page Spread Layout" data-caption="Two-page spread reading mode on desktop">
              <img src="/images/screenshots/win-reader-epub-spread.png" alt="Two-page spread reading mode" width="800" height="500" loading="lazy" />
              <div class="shot-zoom-badge">Click to enlarge</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Feature 3: Navigation & Table of Contents -->
      <section class="feature-block">
        <div class="feature-grid">
          <div class="feature-info">
            <span class="badge badge-accent">Navigation</span>
            <h2>Never lose your place in long volumes</h2>
            <p>
              Lirune builds an interactive, multi-tier Table of Contents from your book's internal navigation documents (NCX or NAV XHTML in EPUB, bookmarks in PDF, and heading trees in DOCX/FB2).
            </p>
            <ul class="feature-check-list">
              <li><strong>Filterable TOC Drawer:</strong> Search chapter titles directly in the drawer to find specific sections instantly.</li>
              <li><strong>Current Position Tracking:</strong> The active chapter is highlighted automatically as you scroll or turn pages.</li>
              <li><strong>Keyboard Navigation:</strong> Jump chapters with <kbd>T</kbd>, navigate search with <kbd>/</kbd>, and toggle fullscreen with <kbd>F11</kbd>.</li>
            </ul>
          </div>
          <div class="feature-media">
            <div class="device-desktop-frame clickable-shot" data-full="/images/screenshots/win-reader-toc.png" data-title="Table of Contents Drawer" data-caption="Interactive TOC with chapter filter">
              <img src="/images/screenshots/win-reader-toc.png" alt="Table of Contents drawer open" width="800" height="500" loading="lazy" />
              <div class="shot-zoom-badge">Click to enlarge</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Feature 4: Typography & Themes -->
      <section class="feature-block">
        <div class="feature-grid reversed">
          <div class="feature-info">
            <span class="badge badge-accent">Visual Comfort</span>
            <h2>Typography tuned for long reading sessions</h2>
            <p>
              Reading fatigue is caused by poor contrast, bad margins, and rigid type. Lirune gives you total control over how words appear on screen.
            </p>
            <ul class="feature-check-list">
              <li><strong>6 Handcrafted Themes:</strong> Dark (default), Pure OLED Black, Clean Light, Nord Frost, Warm Sepia, and Dracula.</li>
              <li><strong>Font Flexibility:</strong> Choose from high-legibility book serifs, modern system sans, or code-friendly monospace.</li>
              <li><strong>Responsive Sizing:</strong> Smooth font scale slider, line height adjustment (1.2 to 2.4), and margin spacing.</li>
              <li><strong>Separation of Chrome & Book:</strong> Application controls remain quiet and neutral, letting the book styling shine.</li>
            </ul>
          </div>
          <div class="feature-media">
            <div class="device-desktop-frame clickable-shot" data-full="/images/screenshots/win-settings-reading.png" data-title="Reading Appearance" data-caption="Typography and theme configuration panel">
              <img src="/images/screenshots/win-settings-reading.png" alt="Reading settings and themes" width="800" height="500" loading="lazy" />
              <div class="shot-zoom-badge">Click to enlarge</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Feature 5: In-Book Search & Annotations -->
      <section class="feature-block">
        <div class="feature-grid">
          <div class="feature-info">
            <span class="badge badge-accent">Study & Research</span>
            <h2>Search inside chapters, take notes, export to Markdown</h2>
            <p>
              Turn Lirune into your personal research workstation. Annotate quotes, highlight key ideas, and export your thinking without proprietary cloud sync.
            </p>
            <ul class="feature-check-list">
              <li><strong>In-Book Search:</strong> Instant chapter search with exact match counters and quick prev/next jumping.</li>
              <li><strong>Multi-Color Highlights:</strong> Highlight text in yellow, green, blue, pink, or purple.</li>
              <li><strong>Sticky Notes:</strong> Add markdown-friendly personal thoughts attached directly to text locations.</li>
              <li><strong>Markdown Export:</strong> Export your highlights, bookmarks, and notes to clean <code>.md</code> files.</li>
            </ul>
          </div>
          <div class="feature-media">
            <div class="device-desktop-frame clickable-shot" data-full="/images/screenshots/win-reader-search.png" data-title="In-Book Search" data-caption="Fast local text search across chapter content">
              <img src="/images/screenshots/win-reader-search.png" alt="In-book search modal" width="800" height="500" loading="lazy" />
              <div class="shot-zoom-badge">Click to enlarge</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Feature 6: Android Mobile Architecture -->
      <section class="feature-block">
        <div class="feature-grid reversed">
          <div class="feature-info">
            <span class="badge badge-success">Android Exclusive</span>
            <h2>Scroll Engine v2 & zero network permissions</h2>
            <p>
              Lirune for Android was rebuilt with a dedicated continuous scroll engine and hardened OS security.
            </p>
            <ul class="feature-check-list">
              <li><strong>Scroll Engine v2:</strong> Unified virtualized continuous scrolling running at 60fps with zero stutter.</li>
              <li><strong>No Internet Permission:</strong> The <code>android.permission.INTERNET</code> permission is stripped from production release builds. The OS physically prevents network calls.</li>
              <li><strong>Storage Access Framework:</strong> Connect SD cards or custom download folders without granting global storage access.</li>
              <li><strong>Offline Text-to-Speech:</strong> Built-in audio narration engine reads books aloud without third-party cloud APIs.</li>
            </ul>
          </div>
          <div class="feature-media">
            <div class="device-phone-frame clickable-shot" data-full="/images/screenshots/android-reader-epub.png" data-title="Android Scroll Engine v2" data-caption="Continuous scroll reading view on Android">
              <div class="device-phone-notch"></div>
              <img src="/images/screenshots/android-reader-epub.png" alt="Android reader interface" width="320" height="693" loading="lazy" />
              <div class="shot-zoom-badge">Enlarge</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <div class="features-cta text-center card card-elevated">
        <h2>Experience Lirune today</h2>
        <p class="mx-auto">Download the latest stable release for Windows or Android.</p>
        <div class="cta-btns">
          <a href="/downloads#windows" class="btn btn-windows btn-lg">Download for Windows</a>
          <a href="/downloads#android" class="btn btn-android btn-lg">Download for Android</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .features-page {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-20);
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .page-header {
    margin-bottom: var(--sp-16);
  }

  .page-title {
    margin-bottom: var(--sp-4);
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 680px;
  }

  .feature-block {
    padding: var(--sp-12) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .feature-block:last-of-type {
    border-bottom: none;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--sp-12);
    align-items: center;
  }

  .feature-grid.reversed {
    grid-template-columns: 1.15fr 1fr;
  }

  .feature-grid.reversed .feature-info {
    order: 2;
  }

  .feature-grid.reversed .feature-media {
    order: 1;
  }

  .feature-info h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    margin: var(--sp-3) 0 var(--sp-4);
  }

  .feature-info p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: var(--sp-6);
  }

  .feature-check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .feature-check-list li {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    padding-left: var(--sp-4);
    border-left: 2px solid var(--accent-chrome);
  }

  .feature-check-list li strong {
    color: var(--text-primary);
  }

  .feature-media {
    position: relative;
  }

  .clickable-shot {
    cursor: pointer;
    position: relative;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .clickable-shot:hover {
    transform: translateY(-2px);
  }

  .shot-zoom-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(17, 21, 27, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--r-full);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .clickable-shot:hover .shot-zoom-badge {
    opacity: 1;
  }

  .features-cta {
    margin-top: var(--sp-16);
    padding: var(--sp-12);
  }

  .features-cta h2 {
    margin-bottom: var(--sp-3);
  }

  .features-cta p {
    margin-bottom: var(--sp-6);
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  kbd {
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-chrome);
  }

  @media (max-width: 900px) {
    .feature-grid, .feature-grid.reversed {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }
    .feature-grid.reversed .feature-info {
      order: 1;
    }
    .feature-grid.reversed .feature-media {
      order: 2;
    }
  }
</style>
