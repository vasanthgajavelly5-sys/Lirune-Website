---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
---

<BaseLayout
  title="Support Lirune Reader — Buy Me a Coffee & Community"
  description="Support the ongoing development of Lirune Reader. Buy Me a Coffee, star the repository, report bugs, or contribute code."
>
  <div class="support-page">
    <div class="container container-narrow">
      <div class="page-header text-center">
        <span class="section-label">Community & Sustainability</span>
        <h1 class="page-title">Support Lirune Reader</h1>
        <p class="page-subtitle mx-auto">
          Lirune is independently developed and maintained with care. Here is how you can support its continued growth.
        </p>
      </div>

      <!-- Main Buy Me a Coffee Block -->
      <section class="support-main-card card text-center">
        <div class="coffee-icon-bubble mx-auto">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 3v2M14 3v2M5 8h14l-1.2 10.1A3.3 3.3 0 0 1 14.5 21h-5a3.3 3.3 0 0 1-3.3-2.9L5 8Z"/>
            <path d="M19 10h1a2 2 0 0 1 0 4h-1M8 11v4M12 11v4M16 11v4"/>
          </svg>
        </div>

        <h2>Buy Me a Coffee</h2>
        <p class="support-explainer mx-auto">
          Lirune is completely free software with no subscriptions, in-app purchases, or ads. If Lirune has made your reading experience calmer and more enjoyable, consider buying a coffee to support development time, device testing, and maintenance.
        </p>

        <div class="coffee-cta-wrap">
          <a
            href={config.buyMeACoffeeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-coffee btn-lg"
            aria-label="Support Lirune Reader on Buy Me a Coffee"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 3v2M14 3v2M5 8h14l-1.2 10.1A3.3 3.3 0 0 1 14.5 21h-5a3.3 3.3 0 0 1-3.3-2.9L5 8Z"/>
              <path d="M19 10h1a2 2 0 0 1 0 4h-1M8 11v4M12 11v4M16 11v4"/>
            </svg>
            Support on Buy Me a Coffee
          </a>
        </div>
        <span class="official-url-tag">Official Link: <code>{config.buyMeACoffeeUrl}</code></span>
      </section>

      <!-- Other Ways to Help -->
      <section class="ways-to-help-section">
        <h2>Other Meaningful Ways to Support</h2>

        <div class="help-grid">
          <div class="card help-card">
            <h3>Star the Repository</h3>
            <p>Starring Lirune on GitHub increases the project's discoverability among readers and open-source software enthusiasts worldwide.</p>
            <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              Star on GitHub →
            </a>
          </div>

          <div class="card help-card">
            <h3>Report Bugs & Edge Cases</h3>
            <p>Encountered a malformed EPUB, broken comic archive, or visual glitch? Open an issue with reproduction details so we can fix it.</p>
            <a href={config.githubIssues} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              Open an Issue →
            </a>
          </div>

          <div class="card help-card">
            <h3>Suggest Improvements</h3>
            <p>Have ideas for reader typography, shortcuts, or format improvements? We actively review thoughtful, reader-focused feedback.</p>
            <a href={config.githubIssues} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              Feature Requests →
            </a>
          </div>

          <div class="card help-card">
            <h3>Contribute Code</h3>
            <p>Lirune follows strict modernization and test gates. If you are a developer, check out our contributing guidelines and submit a PR.</p>
            <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              Contributing Guide →
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .support-page {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-20);
  }

  .text-center { text-align: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .page-header {
    margin-bottom: var(--sp-12);
  }

  .page-title {
    margin-bottom: var(--sp-4);
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .support-main-card {
    padding: clamp(var(--sp-8), 6vw, var(--sp-16));
    background: linear-gradient(180deg, var(--bg-surface) 0%, #151A22 100%);
    border: 1px solid var(--border-strong);
    margin-bottom: var(--sp-16);
  }

  .coffee-icon-bubble {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 221, 0, 0.14);
    color: var(--color-coffee);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-6);
    border: 1px solid rgba(255, 221, 0, 0.3);
  }

  .support-main-card h2 {
    font-size: 1.8rem;
    margin-bottom: var(--sp-3);
  }

  .support-explainer {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: var(--sp-8);
  }

  .coffee-cta-wrap {
    margin-bottom: var(--sp-4);
  }

  .official-url-tag {
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }

  .official-url-tag code {
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent-chrome);
  }

  .ways-to-help-section h2 {
    font-size: 1.5rem;
    margin-bottom: var(--sp-6);
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-6);
  }

  .help-card {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
  }

  .help-card h3 {
    font-size: 1.15rem;
    margin-bottom: var(--sp-2);
  }

  .help-card p {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: var(--sp-4);
    flex-grow: 1;
  }
</style>
