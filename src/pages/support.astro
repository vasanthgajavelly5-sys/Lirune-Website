---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
---

<BaseLayout
  title="Support Lirune Reader — Buy Me a Coffee & Community"
  description="Support the ongoing development of Lirune Reader through Buy Me a Coffee, GitHub contributions, format testing, and feedback."
  canonicalPath="/support"
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="section-header">
      <span class="badge badge-success">Community & Support</span>
      <h1>Support Lirune Reader</h1>
      <p>Lirune is an independent, non-commercial open-source project. Here is how you can support ongoing development and keep it sustainable.</p>
    </div>

    <!-- Buy Me a Coffee Feature Card -->
    <section class="coffee-card surface-card">
      <div class="coffee-badge">☕ Support Creator</div>
      <h2>Buy Me a Coffee</h2>
      <p class="coffee-desc">
        If Lirune has given you a calm and reliable home for your books, consider supporting development directly. Contributions help cover developer tooling, test devices, and ongoing maintenance.
      </p>
      <div class="coffee-action-row">
        <a href={config.buyMeACoffeeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-coffee">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.216 6.415l-.132-.666c-.119-.597-.384-1.144-.77-1.58-.387-.437-.878-.755-1.428-.925C17.336 3.074 16.762 3 16.182 3H4.116c-.57 0-1.135.071-1.682.235-.55.166-1.043.483-1.434.92-.39.435-.658.983-.777 1.58-.12.597-.12 1.21-.12 1.83v7.45c0 1.25.438 2.45 1.233 3.39.795.94 1.905 1.54 3.125 1.69 1.11.13 2.23.2 3.35.2h4.56c1.12 0 2.24-.07 3.35-.2 1.22-.15 2.33-.75 3.12-1.69.8-.94 1.24-2.14 1.24-3.39v-2.11c.96-.13 1.86-.59 2.53-1.29.68-.7 1.07-1.63 1.09-2.61.02-.97-.33-1.92-.99-2.64-.67-.71-1.57-1.18-2.54-1.32zm-.72 4.41c-.24.25-.56.41-.91.46-.35.05-.71 0-1.01-.15l-.1-.05V6.83l.1-.05c.3-.15.66-.2 1.01-.15.35.05.67.21.91.46.24.25.38.58.39.93.01.35-.11.69-.39.93zM4 5h12v9c0 .8-.32 1.57-.88 2.12-.56.56-1.32.88-2.12.88H7c-.8 0-1.56-.32-2.12-.88C4.32 15.57 4 14.8 4 14V5z"/>
          </svg>
          <span>Buy Me a Coffee (vasanthgajavelly) ↗</span>
        </a>
      </div>
    </section>

    <!-- Other Ways to Contribute -->
    <div class="support-grid">
      <div class="support-card surface-card">
        <div class="support-icon">⭐</div>
        <h3>Star on GitHub</h3>
        <p>Starring the repository helps increase visibility so more readers can discover a private, offline reading alternative.</p>
        <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>Star Lirune on GitHub ↗</span>
        </a>
      </div>

      <div class="support-card surface-card">
        <div class="support-icon">🐛</div>
        <h3>Report Bugs & Edge Cases</h3>
        <p>Found a document that renders incorrectly or a UI layout bug? Submit an issue with sample files so we can fix it.</p>
        <a href={config.githubIssues} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>Open GitHub Issue ↗</span>
        </a>
      </div>

      <div class="support-card surface-card">
        <div class="support-icon">💻</div>
        <h3>Contribute Code</h3>
        <p>Lirune is written with standard TypeScript, Electron, React Native, and web technologies. Pull requests are welcomed.</p>
        <a href={config.githubRepo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>View Contribution Guide ↗</span>
        </a>
      </div>

      <div class="support-card surface-card">
        <div class="support-icon">🗣️</div>
        <h3>Share with Readers</h3>
        <p>Tell friends, book clubs, and colleagues who value distraction-free reading and digital privacy about Lirune.</p>
        <a href="/" class="btn btn-secondary">
          <span>Share Lirune Homepage →</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .coffee-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: clamp(32px, 6vw, 48px);
    margin-bottom: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    box-shadow: var(--shadow-md);
  }

  .coffee-badge {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-coffee);
  }

  .coffee-card h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .coffee-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  .coffee-action-row {
    margin-top: var(--sp-2);
  }

  .btn-coffee {
    background-color: var(--color-coffee);
    color: var(--color-coffee-text);
    font-weight: 700;
    padding: 14px 24px;
    box-shadow: 0 4px 16px rgba(245, 158, 11, 0.25);
  }

  .btn-coffee:hover {
    background-color: #F59E0B;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.35);
  }

  /* Support Grid */
  .support-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 640px) {
    .support-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .support-card {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .support-icon {
    font-size: 1.8rem;
  }

  .support-card h3 {
    font-size: 1.15rem;
  }

  .support-card p {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1 1 auto;
    margin-bottom: var(--sp-2);
  }
</style>
