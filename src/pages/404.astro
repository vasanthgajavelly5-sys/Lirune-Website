---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) — Lirune Reader"
  description="The requested page could not be found in Lirune Reader's library catalogue."
  canonicalPath="/404"
  noindex={true}
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="error-card surface-card text-center">
      <div class="error-badge">404</div>
      <h1 class="error-title">Page Not Found in Catalogue</h1>
      <p class="error-desc">
        The page you are looking for may have been moved, renamed, or was never catalogued. Let's get you back to the library.
      </p>

      <div class="error-actions">
        <a href="/" class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Back to Homepage</span>
        </a>
        <a href="/downloads" class="btn btn-secondary btn-lg">
          <span>Get Downloads</span>
        </a>
        <a href="/formats" class="btn btn-subtle btn-lg">
          <span>Supported Formats</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-card {
    padding: clamp(48px, 8vw, 84px) var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .error-badge {
    font-family: var(--font-mono);
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--accent-chrome);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .error-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }

  .error-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 520px;
    margin-bottom: var(--sp-4);
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
</style>
