---
import BaseLayout from '../layouts/BaseLayout.astro';
import formats from '../data/formats.json';

const categories = ['All', ...new Set(formats.map(f => f.category))];
---

<BaseLayout
  title="50+ Formats Supported & Compatibility Matrix — Lirune Reader"
  description="Comprehensive compatibility matrix of 50+ document, ebook, spreadsheet, presentation, comic, and image formats supported by Lirune Reader on Windows and Android."
  canonicalPath="/formats"
>
  <div class="site-container section-spacing">
    <div class="section-header section-header--center" data-reveal>
      <span class="badge badge-success">50+ Formats Supported</span>
      <h1>50+ Formats Supported</h1>
      <p>Read ebooks, documents, presentations, comics and images in one private, offline-first reader. Zero external server dependencies.</p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="matrix-controls-card" data-reveal>
      <div class="search-input-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="format-search-input"
          placeholder="Filter by format or extension (e.g. epub, pdf, cbz, fb2, docx)…"
          class="matrix-search-input"
          aria-label="Filter formats by name or extension"
        />
      </div>

      <div class="category-pills" role="radiogroup" aria-label="Format Category Filter">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class:list={['category-pill-btn', { active: idx === 0 }]}
            data-category={cat}
            role="radio"
            aria-checked={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Formats 2-Column Responsive Grid -->
    <div class="formats-grid" id="formats-container" data-stagger>
      {formats.map(f => (
        <article
          class="format-card surface-card"
          data-format-id={f.id}
          data-format-category={f.category}
          data-search-terms={`${f.id} ${f.name} ${f.extensions.join(' ')} ${f.category} ${f.engine}`.toLowerCase()}
        >
          <div class="format-card-top">
            <div class="format-ext-badge">
              {f.extensions[0].replace('.', '').toUpperCase()}
            </div>
            <div class="format-meta">
              <div class="format-title-row">
                <h3 class="format-name">{f.name}</h3>
                <span class:list={['status-indicator', f.status.toLowerCase().includes('fully') ? 'status-full' : 'status-partial']}>
                  {f.status}
                </span>
              </div>
              <div class="format-tags">
                <span class="tag-pill">{f.category}</span>
                <span class="tag-pill layout-tag">{f.layout}</span>
                <span class="tag-pill extensions-tag">{f.extensions.join(', ')}</span>
              </div>
            </div>
          </div>

          <div class="format-specs">
            <div class="spec-item">
              <span class="spec-label">Rendering Engine</span>
              <p class="spec-val">{f.engine}</p>
            </div>
            <div class="spec-item">
              <span class="spec-label">Capabilities</span>
              <p class="spec-val">{f.details}</p>
            </div>
            {f.limitations && (
              <div class="spec-item spec-item--notice">
                <span class="spec-label">Security & DRM Notice</span>
                <p class="spec-val">{f.limitations}</p>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div class="formats-empty surface-card" id="formats-empty-state" hidden>
      <div class="empty-icon">🔍</div>
      <h3>No formats match your query</h3>
      <p>Try searching for a different extension like <code>epub</code>, <code>pdf</code>, <code>cbz</code>, or <code>fb2</code>.</p>
      <button type="button" class="btn btn-secondary" id="reset-filter-btn">
        <span>Reset Filters</span>
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .matrix-controls-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-xl);
    padding: var(--sp-5);
    margin-bottom: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    box-shadow: var(--shadow-sm);
  }

  .search-input-wrap {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .matrix-search-input {
    width: 100%;
    padding: 13px 16px 13px 48px;
    border-radius: var(--r-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-size: 0.98rem;
    transition: border-color var(--t-fast), background-color var(--t-fast), box-shadow var(--t-fast);
  }

  .matrix-search-input:focus-visible {
    outline: none;
    border-color: var(--focus-ring);
    background-color: var(--bg-surface);
    box-shadow: 0 0 0 3px var(--accent-chrome-subtle);
  }

  .category-pills {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .category-pill-btn {
    padding: 6px 14px;
    border-radius: var(--r-full);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }

  .category-pill-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
  }

  .category-pill-btn.active {
    background-color: var(--accent);
    color: var(--text-on-accent);
    font-weight: 600;
    border-color: transparent;
  }

  /* Formats 2-Column Responsive Grid */
  .formats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }

  @media (min-width: 860px) {
    .formats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .format-card {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    height: 100%;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }

  .format-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .format-card-top {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
  }

  .format-ext-badge {
    width: 50px;
    height: 50px;
    border-radius: var(--r-lg);
    background-color: var(--accent-chrome-subtle);
    border: 1px solid var(--border-accent);
    color: var(--accent-chrome);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.92rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .format-meta {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .format-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .format-name {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .status-indicator {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--r-full);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .status-full {
    background-color: rgba(52, 211, 153, 0.15);
    color: var(--status-success);
    border: 1px solid rgba(52, 211, 153, 0.30);
  }

  .status-partial {
    background-color: rgba(251, 191, 36, 0.15);
    color: var(--status-warning);
    border: 1px solid rgba(251, 191, 36, 0.30);
  }

  .format-tags {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .tag-pill {
    font-size: 0.76rem;
    padding: 2px 8px;
    border-radius: var(--r-sm);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--text-tertiary);
  }

  .layout-tag {
    color: var(--text-secondary);
  }

  .extensions-tag {
    font-family: var(--font-mono);
    color: var(--text-primary);
    font-weight: 600;
  }

  .format-specs {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .spec-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  .spec-val {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .spec-item--notice {
    padding: 8px 12px;
    border-radius: var(--r-sm);
    background-color: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.20);
  }

  .spec-item--notice .spec-label {
    color: var(--status-warning);
  }

  .spec-item--notice .spec-val {
    color: var(--text-primary);
    font-size: 0.84rem;
  }

  /* Empty State */
  .formats-empty {
    text-align: center;
    padding: clamp(48px, 6vw, 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }

  .empty-icon {
    font-size: 2.5rem;
    margin-bottom: var(--sp-2);
  }

  .formats-empty[hidden] {
    display: none;
  }
</style>

<script>
  function setupFormatsFilter() {
    const searchInput = document.getElementById('format-search-input') as HTMLInputElement | null;
    const categoryButtons = document.querySelectorAll<HTMLButtonElement>('.category-pill-btn');
    const formatCards = document.querySelectorAll<HTMLElement>('.format-card');
    const emptyState = document.getElementById('formats-empty-state');
    const resetBtn = document.getElementById('reset-filter-btn');

    let activeCategory = 'All';
    let searchQuery = '';

    function filterRows() {
      let visibleCount = 0;
      formatCards.forEach(card => {
        const rowCategory = card.getAttribute('data-format-category') || '';
        const searchTerms = card.getAttribute('data-search-terms') || '';

        const matchesCategory = activeCategory === 'All' || rowCategory === activeCategory;
        const matchesSearch = searchQuery === '' || searchTerms.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterRows();
    });

    categoryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-checked', 'true');
        activeCategory = btn.getAttribute('data-category') || 'All';
        filterRows();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeCategory = 'All';
      categoryButtons.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add('active');
          b.setAttribute('aria-checked', 'true');
        } else {
          b.classList.remove('active');
          b.setAttribute('aria-checked', 'false');
        }
      });
      filterRows();
    });
  }

  document.addEventListener('astro:page-load', setupFormatsFilter);
</script>
