---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import releases from '../data/releases.json';
---

<BaseLayout
  title="Downloads Hub — Lirune Reader for Windows & Android"
  description="Download the latest verified public stable releases of Lirune Reader for Windows (v6.0.0) and Android (v5.0.0) with SHA-256 checksums and Microsoft Store links."
  canonicalPath="/downloads"
>
  <div class="site-container section-spacing">
    <div class="section-header section-header--center">
      <span class="badge badge-success">Official Releases</span>
      <h1>Download Lirune Reader</h1>
      <p>Free, open-source, and offline forever. Choose your platform below for verified public installation packages.</p>
    </div>

    <!-- Dual Platform Download Cards Grid -->
    <div class="downloads-split-grid">
      <!-- Windows Platform Card -->
      <section class="download-card surface-card" id="windows" aria-labelledby="win-download-heading">
        <div class="download-card-header">
          <div class="platform-icon-wrap windows">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
            </svg>
          </div>
          <div class="platform-heading-meta">
            <div class="platform-badge-row">
              <span class="platform-tag windows">Windows</span>
              <span class="version-label">v{releases.windows.version} Stable</span>
            </div>
            <h2 id="win-download-heading" class="platform-title">Lirune for Windows</h2>
          </div>
        </div>

        <p class="download-card-desc">
          Full desktop reading immersion with two-page book spreads, instant full-text search, customizable keyboard shortcuts, and strict HTML sanitization.
        </p>

        <!-- Technical Specification Panel (Filenames moved here) -->
        <div class="download-spec-panel">
          <div class="spec-row">
            <span class="spec-label">Latest Version</span>
            <span class="spec-value font-mono">v{releases.windows.version}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Compatibility</span>
            <span class="spec-value">{releases.windows.requirements}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Architecture</span>
            <span class="spec-value">x64 (64-bit)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Package Filename</span>
            <span class="spec-value font-mono package-name">{releases.windows.installerFilename}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">License</span>
            <span class="spec-value">GNU GPL-3.0 (Copyleft)</span>
          </div>
        </div>

        <!-- Clean Download Buttons (Simplified labels) -->
        <div class="download-button-stack">
          <a href={releases.windows.installerUrl} class="btn btn-primary btn-action-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download Windows Installer</span>
          </a>

          <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-action-lg btn-store">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
            </svg>
            <span>Get from Microsoft Store</span>
          </a>
        </div>

        <!-- Collapsible Verify Download Section -->
        <details class="verify-details" id="verify-win">
          <summary class="verify-summary">
            <svg class="summary-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span>Verify Download (SHA-256)</span>
          </summary>
          <div class="verify-content">
            <div class="checksum-header">
              <span class="checksum-target-label">Setup.exe Checksum:</span>
              <button
                type="button"
                class="copy-checksum-btn"
                data-checksum={releases.windows.sha256}
                title="Copy SHA-256 Checksum"
              >
                Copy Hash
              </button>
            </div>
            <code class="checksum-hash">{releases.windows.sha256}</code>
            <p class="verify-instructions">
              To verify on Windows, run in PowerShell:
              <br />
              <code>certutil -hashfile {releases.windows.installerFilename} SHA256</code>
            </p>
          </div>
        </details>
      </section>

      <!-- Android Platform Card -->
      <section class="download-card surface-card" id="android" aria-labelledby="android-download-heading">
        <div class="download-card-header">
          <!-- Optically centered official Android bugdroid icon -->
          <div class="platform-icon-wrap android">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"/>
            </svg>
          </div>
          <div class="platform-heading-meta">
            <div class="platform-badge-row">
              <span class="platform-tag android">Android</span>
              <span class="version-label">v{releases.android.version} Stable</span>
            </div>
            <h2 id="android-download-heading" class="platform-title">Lirune for Android</h2>
          </div>
        </div>

        <p class="download-card-desc">
          High-performance Scroll Engine v2 delivering 60fps virtualized scrolling, offline Text-to-Speech audio narration, and zero internet permissions.
        </p>

        <!-- Technical Specification Panel (Filenames moved here) -->
        <div class="download-spec-panel">
          <div class="spec-row">
            <span class="spec-label">Latest Version</span>
            <span class="spec-value font-mono">v{releases.android.version}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Compatibility</span>
            <span class="spec-value">{releases.android.requirements}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Permissions</span>
            <span class="spec-value">Zero Internet (android.permission.INTERNET removed)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Package Filename</span>
            <span class="spec-value font-mono package-name">{releases.android.apkFilename}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Distribution</span>
            <span class="spec-value">Direct Release APK (GitHub)</span>
          </div>
        </div>

        <!-- Clean Download Buttons (Simplified labels) -->
        <div class="download-button-stack">
          <a href={releases.android.apkUrl} class="btn btn-primary btn-action-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download Android APK</span>
          </a>

          <a href={releases.android.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-action-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub Release Notes</span>
          </a>
        </div>

        <!-- Collapsible Verify Download Section -->
        <details class="verify-details" id="verify-android">
          <summary class="verify-summary">
            <svg class="summary-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span>Verify Download (SHA-256)</span>
          </summary>
          <div class="verify-content">
            <div class="checksum-header">
              <span class="checksum-target-label">Release APK Checksum:</span>
              <button
                type="button"
                class="copy-checksum-btn"
                data-checksum={releases.android.sha256}
                title="Copy SHA-256 Checksum"
              >
                Copy Hash
              </button>
            </div>
            <code class="checksum-hash">{releases.android.sha256}</code>
            <p class="verify-instructions">
              To verify on Linux/macOS or Android terminal, run:
              <br />
              <code>sha256sum {releases.android.apkFilename}</code>
            </p>
          </div>
        </details>
      </section>
    </div>

    {releases.windowsBeta && releases.androidBeta && (
      <div class="beta-releases-section" id="beta-channel">
        <div class="section-header section-header--center">
          <span class="badge badge-warning">Beta Channel</span>
          <h2>Preview &amp; Beta Releases</h2>
          <p>Test the upcoming universal 23-format engine, Hermes bytecode optimizations, and enhanced security hardening. Clearly marked for early testing.</p>
        </div>

        <div class="downloads-split-grid">
          <!-- Windows Beta Card -->
          <section class="download-card surface-card beta-card" id="windows-beta">
            <div class="download-card-header">
              <div class="platform-icon-wrap windows">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
                </svg>
              </div>
              <div class="platform-heading-meta">
                <div class="platform-badge-row">
                  <span class="platform-tag windows">Windows</span>
                  <span class="version-label beta-label">v{releases.windowsBeta.version} Beta</span>
                </div>
                <h3 class="platform-title">Lirune for Windows (Beta)</h3>
              </div>
            </div>

            <p class="download-card-desc">
              Universal 23-format engine (Kindle MOBI, Word, PowerPoint, TIFF, CHM, Comic Archives), refined keyboard shortcuts toolbar, and compact theme swatches.
            </p>

            <div class="download-spec-panel">
              <div class="spec-row">
                <span class="spec-label">Channel</span>
                <span class="spec-value font-mono">Beta / Pre-Release</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Version</span>
                <span class="spec-value font-mono">v{releases.windowsBeta.version}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Package Filename</span>
                <span class="spec-value font-mono package-name">{releases.windowsBeta.installerFilename}</span>
              </div>
            </div>

            <div class="download-button-stack">
              <a href={releases.windowsBeta.installerUrl} class="btn btn-primary btn-action-lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Windows Beta Installer</span>
              </a>
              <a href={releases.windowsBeta.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <span>View GitHub Release Notes</span>
              </a>
            </div>

            <details class="verify-details" id="verify-win-beta">
              <summary class="verify-summary">
                <svg class="summary-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <span>Verify Download (SHA-256)</span>
              </summary>
              <div class="verify-content">
                <div class="checksum-header">
                  <span class="checksum-target-label">Setup.exe Checksum:</span>
                  <button type="button" class="copy-checksum-btn" data-checksum={releases.windowsBeta.sha256} title="Copy SHA-256 Checksum">Copy Hash</button>
                </div>
                <code class="checksum-hash">{releases.windowsBeta.sha256}</code>
              </div>
            </details>
          </section>

          <!-- Android Beta Card -->
          <section class="download-card surface-card beta-card" id="android-beta">
            <div class="download-card-header">
              <div class="platform-icon-wrap android">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"/>
                </svg>
              </div>
              <div class="platform-heading-meta">
                <div class="platform-badge-row">
                  <span class="platform-tag android">Android</span>
                  <span class="version-label beta-label">v{releases.androidBeta.version} Beta</span>
                </div>
                <h3 class="platform-title">Lirune for Android (Beta)</h3>
              </div>
            </div>

            <p class="download-card-desc">
              Pre-compiled Hermes bytecode bundle (13MB), complete 23-format mobile reading engine, and zero-permission hardened release.
            </p>

            <div class="download-spec-panel">
              <div class="spec-row">
                <span class="spec-label">Channel</span>
                <span class="spec-value font-mono">Beta / Pre-Release</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Version</span>
                <span class="spec-value font-mono">v{releases.androidBeta.version}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Package Filename</span>
                <span class="spec-value font-mono package-name">{releases.androidBeta.apkFilename}</span>
              </div>
            </div>

            <div class="download-button-stack">
              <a href={releases.androidBeta.apkUrl} class="btn btn-primary btn-action-lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Android Beta APK</span>
              </a>
              <a href={releases.androidBeta.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <span>View GitHub Release Notes</span>
              </a>
            </div>

            <details class="verify-details" id="verify-android-beta">
              <summary class="verify-summary">
                <svg class="summary-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <span>Verify Download (SHA-256)</span>
              </summary>
              <div class="verify-content">
                <div class="checksum-header">
                  <span class="checksum-target-label">Release APK Checksum:</span>
                  <button type="button" class="copy-checksum-btn" data-checksum={releases.androidBeta.sha256} title="Copy SHA-256 Checksum">Copy Hash</button>
                </div>
                <code class="checksum-hash">{releases.androidBeta.sha256}</code>
              </div>
            </details>
          </section>
        </div>
      </div>
    )}

    <!-- Onboarding Guide Card -->
    <div class="download-guide-card surface-card">
      <div class="guide-lead">
        <h3>Need help with installation?</h3>
        <p>Step-by-step instructions for side-loading APKs on Android or configuring local SQLite storage on Windows.</p>
      </div>
      <div class="guide-actions">
        <a href="/getting-started" class="btn btn-secondary">
          <span>Read Getting Started Guide</span>
        </a>
        <a href="/faq" class="btn btn-secondary">
          <span>View Installation FAQ</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .downloads-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 900px) {
    .downloads-split-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .download-card {
    padding: clamp(24px, 4vw, 36px);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    height: 100%;
    scroll-margin-top: 100px;
  }

  .download-card-header {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .platform-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .platform-icon-wrap.windows {
    background-color: rgba(96, 165, 250, 0.15);
    color: var(--color-windows);
  }

  .platform-icon-wrap.android {
    background-color: rgba(52, 211, 153, 0.15);
    color: var(--color-android);
  }

  .platform-heading-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .platform-badge-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .platform-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--r-sm);
    letter-spacing: 0.04em;
  }

  .platform-tag.windows {
    background-color: rgba(96, 165, 250, 0.16);
    color: var(--color-windows);
  }

  .platform-tag.android {
    background-color: rgba(52, 211, 153, 0.16);
    color: var(--color-android);
  }

  .version-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .platform-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .download-card-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* Technical Specification Panel */
  .download-spec-panel {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 14px 18px;
    border-radius: var(--r-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
  }

  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.86rem;
    gap: var(--sp-3);
  }

  .spec-label {
    color: var(--text-tertiary);
    font-weight: 500;
    white-space: nowrap;
  }

  .spec-value {
    color: var(--text-primary);
    font-weight: 600;
    text-align: right;
    word-break: break-all;
  }

  .package-name {
    color: var(--accent-chrome);
    font-size: 0.82rem;
  }

  /* Simplified Action Buttons */
  .download-button-stack {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .btn-action-lg {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 12px 20px;
    width: 100%;
  }

  /* Collapsible Verify Download Section */
  .verify-details {
