---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import releases from '../data/releases.json';
---

<BaseLayout
  title="Downloads Hub — Lirune Reader for Windows & Android"
  description="Download the latest verified public stable releases of Lirune Reader for Windows (v5.6.2) and Android (v4.9.3) with SHA-256 checksums and Microsoft Store links."
  canonicalPath="/downloads"
>
  <div class="site-container section-spacing">
    <div class="section-header section-header--center">
      <span class="badge badge-success">Official Releases</span>
      <h1>Download Lirune Reader</h1>
      <p>Free, open-source, and offline forever. Choose your platform below for verified public installation packages.</p>
    </div>

    <!-- Dual Platform Download Cards -->
    <div class="downloads-split-grid">
      <!-- Windows Platform Card -->
      <section class="download-card surface-card" aria-labelledby="win-download-heading">
        <div class="download-card-header">
          <div class="platform-icon-wrap windows">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
            </svg>
          </div>
          <div>
            <div class="platform-badge-row">
              <span class="platform-tag windows">Windows</span>
              <span class="version-label">v{releases.windows.version} Stable</span>
            </div>
            <h2 id="win-download-heading" class="platform-title">Lirune for Windows</h2>
          </div>
        </div>

        <p class="download-card-desc">
          Full desktop immersion with two-page book spreads, PDF.js renderer, instant search, and customizable keyboard shortcuts.
        </p>

        <div class="download-spec-list">
          <div class="spec-row">
            <span class="spec-label">Compatibility:</span>
            <span class="spec-value">{releases.windows.requirements}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Architecture:</span>
            <span class="spec-value">x64 (64-bit)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">License:</span>
            <span class="spec-value">GNU GPL-3.0</span>
          </div>
        </div>

        <!-- Download Buttons -->
        <div class="download-button-stack">
          <a href={releases.windows.installerUrl} class="btn btn-primary btn-download">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <div class="btn-text-wrap">
              <span class="btn-main-text">Download Windows Installer</span>
              <span class="btn-sub-text">{releases.windows.installerFilename}</span>
            </div>
          </a>

          <a href={config.microsoftStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-store">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.628h11.377V24H0zm12.623 0H24V24H12.623z"/>
            </svg>
            <span>Get from Microsoft Store</span>
          </a>
        </div>

        <!-- Checksum Box -->
        <div class="checksum-box">
          <div class="checksum-header">
            <span class="checksum-label">SHA-256 Checksum (Setup.exe)</span>
            <button type="button" class="copy-checksum-btn" data-checksum={releases.windows.sha256} title="Copy SHA-256">
              Copy
            </button>
          </div>
          <code class="checksum-code">{releases.windows.sha256}</code>
        </div>
      </section>

      <!-- Android Platform Card -->
      <section class="download-card surface-card" aria-labelledby="android-download-heading">
        <div class="download-card-header">
          <div class="platform-icon-wrap android">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-1.0003s.4482-1.0003.9993-1.0003c.5516 0 .9998.4486.9998 1.0003s-.4482 1.0003-.9998 1.0003m-11.046 0c-.5511 0-.9993-.4486-.9993-1.0003s.4482-1.0003.9993-1.0003c.5516 0 .9998.4486.9998 1.0003s-.4482 1.0003-.9998 1.0003m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4116 13.8533 8.084 12 8.084c-1.8533 0-3.5902.3276-5.1378.8657L4.84 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.152 5.676l1.9972 3.4592C2.6889 16.275 0 20.443 0 25.3333h24c0-4.8903-2.689-9.0583-6.1185-16.0119"/>
            </svg>
          </div>
          <div>
            <div class="platform-badge-row">
              <span class="platform-tag android">Android</span>
              <span class="version-label">v{releases.android.version} Stable</span>
            </div>
            <h2 id="android-download-heading" class="platform-title">Lirune for Android</h2>
          </div>
        </div>

        <p class="download-card-desc">
          Scroll Engine v2 60fps virtualized reader, offline Text-to-Speech audio narration, and zero internet permissions.
        </p>

        <div class="download-spec-list">
          <div class="spec-row">
            <span class="spec-label">Compatibility:</span>
            <span class="spec-value">{releases.android.requirements}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Permissions:</span>
            <span class="spec-value">Zero Internet (android.permission.INTERNET removed)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Distribution:</span>
            <span class="spec-value">Direct Release APK (GitHub)</span>
          </div>
        </div>

        <!-- Download Buttons -->
        <div class="download-button-stack">
          <a href={releases.android.apkUrl} class="btn btn-primary btn-download">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <div class="btn-text-wrap">
              <span class="btn-main-text">Download Release APK</span>
              <span class="btn-sub-text">{releases.android.apkFilename}</span>
            </div>
          </a>

          <a href={releases.android.releaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub Release Assets ↗</span>
          </a>
        </div>

        <!-- Checksum Box -->
        <div class="checksum-box">
          <div class="checksum-header">
            <span class="checksum-label">SHA-256 Checksum (release.apk)</span>
            <button type="button" class="copy-checksum-btn" data-checksum={releases.android.sha256} title="Copy SHA-256">
              Copy
            </button>
          </div>
          <code class="checksum-code">{releases.android.sha256}</code>
        </div>
      </section>
    </div>

    <!-- Installation Instructions Section -->
    <section class="install-guide-section section-spacing--dense">
      <div class="section-header">
        <h2>Installation Instructions</h2>
        <p>Simple, standard setup procedures for both platforms.</p>
      </div>

      <div class="install-steps-grid">
        <div class="surface-card">
          <h3 class="step-card-title">Windows Setup</h3>
          <ol class="step-list">
            <li>
              <strong>Microsoft Store:</strong> Open the Store link and click "Get" for automated background installation and updates.
            </li>
            <li>
              <strong>Installer (.exe):</strong> Download <code>{releases.windows.installerFilename}</code>, double-click to launch, and follow standard setup wizard prompts.
            </li>
            <li>
              <strong>SmartScreen Notice:</strong> Because Lirune is an independent open-source release, click "More info" $\to$ "Run anyway" if prompted by Windows Defender.
            </li>
          </ol>
        </div>

        <div class="surface-card">
          <h3 class="step-card-title">Android Setup</h3>
          <ol class="step-list">
            <li>
              <strong>Download APK:</strong> Download <code>{releases.android.apkFilename}</code> directly to your device.
            </li>
            <li>
              <strong>Side-load Permission:</strong> When prompted by your browser or file manager, allow "Install unknown apps" for that app.
            </li>
            <li>
              <strong>First Launch:</strong> Open Lirune Reader and grant folder access via the Android Storage Access Framework (SAF) to your books directory.
            </li>
          </ol>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .downloads-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-bottom: var(--sp-12);
  }

  @media (min-width: 900px) {
    .downloads-split-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .download-card {
    padding: clamp(28px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .download-card-header {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .platform-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .platform-icon-wrap.windows {
    background-color: rgba(0, 120, 215, 0.12);
    color: var(--color-windows);
  }

  .platform-icon-wrap.android {
    background-color: rgba(61, 220, 132, 0.12);
    color: var(--color-android);
  }

  .platform-badge-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: 4px;
  }

  .platform-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--r-sm);
  }

  .platform-tag.windows {
    background-color: rgba(0, 120, 215, 0.15);
    color: var(--color-windows);
  }

  .platform-tag.android {
    background-color: rgba(61, 220, 132, 0.15);
    color: var(--color-android);
  }

  .version-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .platform-title {
    font-size: 1.45rem;
    font-weight: 700;
  }

  .download-card-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .download-spec-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 18px;
    border-radius: var(--r-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
  }

  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.86rem;
    gap: var(--sp-2);
  }

  .spec-label {
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .spec-value {
    color: var(--text-primary);
    font-weight: 600;
    text-align: right;
  }

  .download-button-stack {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .btn-download {
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--sp-3);
  }

  .btn-text-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .btn-main-text {
    font-size: 1rem;
    font-weight: 700;
  }

  .btn-sub-text {
    font-size: 0.78rem;
    font-weight: 400;
    opacity: 0.85;
  }

  .btn-store {
    padding: 12px 20px;
  }

  /* Checksum Box */
  .checksum-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 16px;
    border-radius: var(--r-md);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
  }

  .checksum-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .checksum-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }

  .copy-checksum-btn {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--r-sm);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .copy-checksum-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .checksum-code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-secondary);
    word-break: break-all;
    line-height: 1.4;
  }

  /* Installation Guide */
  .install-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 768px) {
    .install-steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .step-card-title {
    font-size: 1.15rem;
    margin-bottom: var(--sp-4);
  }

  .step-list {
    list-style: decimal inside;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .step-list strong {
    color: var(--text-primary);
  }
</style>

<script>
  function setupCopyChecksum() {
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-checksum-btn');
    copyButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const checksum = btn.getAttribute('data-checksum');
        if (!checksum) return;
        try {
          await navigator.clipboard.writeText(checksum);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch (err) {}
      });
    });
  }

  setupCopyChecksum();
  document.addEventListener('astro:page-load', setupCopyChecksum);
</script>
