---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import faqData from '../data/faq.json';
---

<BaseLayout
  title="Frequently Asked Questions (FAQ) — Lirune Reader"
  description="Answers to common questions about Lirune Reader: offline privacy, 50+ format capabilities, DRM boundaries, local storage, and open source development."
  canonicalPath="/faq"
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="section-header section-header--center" data-reveal>
      <span class="badge badge-success">Common Questions</span>
      <h1>Frequently Asked Questions</h1>
      <p>Clear, direct answers regarding Lirune's offline architecture, format capabilities, device support, and open source principles.</p>
    </div>

    <!-- Search Input for FAQ -->
    <div class="faq-search-wrap" data-reveal>
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="faq-search-input"
        placeholder="Search questions (e.g. offline, privacy, formats, android, windows)..."
        class="faq-search-input"
        aria-label="Filter frequently asked questions"
      />
    </div>

    <!-- Accordion List -->
    <div class="faq-accordion-list" id="faq-list" role="region" aria-label="FAQ Question List">
      {faqData.map((item, idx) => {
        const question = item.q || item.question;
        const answer = item.a || item.answer;
        const isOpen = idx === 0;
        return (
          <details
            class="faq-accordion-item surface-card"
            open={isOpen}
            data-faq-text={`${question} ${answer}`.toLowerCase()}
          >
            <summary class="faq-summary" role="button" aria-expanded={isOpen ? "true" : "false"}>
              <span class="faq-question-text">{question}</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer-content">
              <p>{answer}</p>
            </div>
          </details>
        );
      })}
    </div>

    <!-- No results message -->
    <div id="faq-no-results" class="faq-no-results surface-card text-center hidden" aria-live="polite">
      <p>No matching questions found. Try searching for "offline", "formats", "windows", or "android".</p>
    </div>

    <!-- Still have questions? -->
    <div class="faq-footer-card surface-card text-center" data-reveal>
      <h3>Have another question or want to report an issue?</h3>
      <p>Lirune is developed openly in the public domain. You can open an issue or start a discussion on our GitHub repository.</p>
      <div class="faq-footer-actions">
        <a href={config.githubIssues} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>GitHub Issues & Discussions ↗</span>
        </a>
        <a href="/support" class="btn btn-subtle">
          <span>Support Lirune →</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .faq-search-wrap {
    position: relative;
    margin-bottom: var(--sp-8);
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .faq-search-input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    border-radius: var(--r-md);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-size: 1rem;
    outline: none;
    transition: all var(--t-fast);
  }

  .faq-search-input:focus {
    border-color: var(--focus-ring);
    box-shadow: 0 0 0 3px var(--accent-chrome-subtle);
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-bottom: var(--sp-12);
  }

  .faq-accordion-item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    background-color: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }

  .faq-accordion-item[open] {
    border-color: var(--border-accent);
    box-shadow: var(--shadow-sm);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 18px 22px;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question-text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    text-align: left;
    flex: 1;
  }

  .faq-chevron {
    color: var(--text-tertiary);
    transition: transform var(--t-fast);
    flex-shrink: 0;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-answer-content {
    padding: 0 22px 22px 22px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 16px;
  }

  .faq-answer-content p {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .faq-no-results {
    padding: var(--sp-8);
    margin-bottom: var(--sp-10);
    border: 1px dashed var(--border-strong);
    color: var(--text-secondary);
  }

  .faq-no-results.hidden {
    display: none;
  }

  .faq-footer-card {
    padding: clamp(32px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .faq-footer-card h3 {
    font-size: 1.25rem;
  }

  .faq-footer-card p {
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0;
  }

  .faq-footer-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-2);
  }

  .text-center {
    text-align: center;
  }
</style>

<script>
  function setupFaqSearch() {
    const input = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLDetailsElement>('.faq-accordion-item');
    const noResults = document.getElementById('faq-no-results');

    // Sync aria-expanded
    items.forEach(details => {
      const summary = details.querySelector<HTMLElement>('.faq-summary');
      if (summary) {
        details.addEventListener('toggle', () => {
          summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
        });
      }
    });

    // Real-time search filter
    input?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let matchCount = 0;

      items.forEach(item => {
        const text = item.getAttribute('data-faq-text') || '';
        if (q === '' || text.includes(q)) {
          item.style.display = '';
          matchCount++;
          if (q.length > 2) {
            item.setAttribute('open', 'true');
          }
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        if (matchCount === 0 && q.length > 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    });
  }

  setupFaqSearch();
  document.addEventListener('astro:page-load', setupFaqSearch);
</script>
