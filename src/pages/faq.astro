---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
import faqData from '../data/faq.json';
---

<BaseLayout
  title="Frequently Asked Questions (FAQ) — Lirune Reader"
  description="Answers to common questions about Lirune Reader: offline privacy, format support, DRM limits, local storage, and open source development."
  canonicalPath="/faq"
>
  <div class="site-container site-container--narrow section-spacing">
    <div class="section-header">
      <span class="badge badge-success">Common Questions</span>
      <h1>Frequently Asked Questions</h1>
      <p>Clear, direct answers regarding Lirune's offline architecture, format capabilities, device support, and open source principles.</p>
    </div>

    <!-- Search Input for FAQ -->
    <div class="faq-search-wrap">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="faq-search-input"
        placeholder="Search questions (e.g. offline, drm, sync, formats)..."
        class="faq-search-input"
        aria-label="Filter frequently asked questions"
      />
    </div>

    <!-- Accordion List -->
    <div class="faq-accordion-list" id="faq-list">
      {faqData.map((item, idx) => (
        <details class="faq-accordion-item surface-card" data-faq-text={`${item.question} ${item.answer}`.toLowerCase()}>
          <summary class="faq-summary">
            <span class="faq-question-text">{item.question}</span>
            <span class="faq-chevron" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer-content">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Still have questions? -->
    <div class="faq-footer-card surface-card text-center">
      <h3>Have another question or want to report an issue?</h3>
      <p>Lirune is developed openly in the public domain. You can open an issue or start a discussion on our GitHub repository.</p>
      <div class="faq-footer-actions">
        <a href={config.githubIssues} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span>GitHub Issues & Discussions ↗</span>
        </a>
        <a href="/support" class="btn btn-subtle">
          <span>Support Lirune →</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .faq-search-wrap {
    position: relative;
    margin-bottom: var(--sp-8);
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .faq-search-input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    border-radius: var(--r-md);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-size: 1rem;
    outline: none;
    transition: all var(--t-fast);
  }

  .faq-search-input:focus {
    border-color: var(--focus-ring);
    box-shadow: 0 0 0 3px var(--accent-chrome-subtle);
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-bottom: var(--sp-12);
  }

  .faq-accordion-item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }

  .faq-accordion-item[open] {
    border-color: var(--border-default);
    box-shadow: var(--shadow-sm);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 18px 22px;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question-text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .faq-chevron {
    color: var(--text-tertiary);
    transition: transform var(--t-fast);
    flex-shrink: 0;
  }

  .faq-accordion-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .faq-answer-content {
    padding: 0 22px 22px 22px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 16px;
  }

  .faq-answer-content p {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .faq-footer-card {
    padding: clamp(32px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .faq-footer-card h3 {
    font-size: 1.25rem;
  }

  .faq-footer-card p {
    color: var(--text-secondary);
    max-width: 540px;
  }

  .faq-footer-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-2);
  }
</style>

<script>
  function setupFaqSearch() {
    const input = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLElement>('.faq-accordion-item');

    input?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      items.forEach(item => {
        const text = item.getAttribute('data-faq-text') || '';
        if (q === '' || text.includes(q)) {
          item.style.display = '';
          if (q.length > 2) {
            item.setAttribute('open', 'true');
          }
        } else {
          item.style.display = 'none';
        }
      });
    });
  }

  setupFaqSearch();
  document.addEventListener('astro:page-load', setupFaqSearch);
</script>
