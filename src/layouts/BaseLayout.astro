---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScreenshotLightbox from '../components/ScreenshotLightbox.astro';
import { ClientRouter } from 'astro:transitions';
import config from '../data/config.json';
import releases from '../data/releases.json';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "Lirune Reader — A calm, private home for your library",
  description = "Official website of Lirune Reader: the free, open-source, offline ebook and document reader for Windows and Android. 50+ formats supported with zero telemetry.",
  canonicalPath = Astro.url.pathname,
  image = "/images/branding/og-preview.png",
  type = "website",
  noindex = false
} = Astro.props;

// Normalise canonical URL (no trailing slash for non-root paths)
const cleanPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/+$/, '');
const isHomePage = cleanPath === '/';
const siteHostname = new URL(config.siteUrl).hostname;
const canonicalUrl = new URL(cleanPath, config.siteUrl).href;
const fullImageUrl = new URL(image, config.siteUrl).href;

// JSON-LD Structured Data (WebSite is homepage-only per Google Site Name guidelines)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...(isHomePage ? [{
      "@type": "WebSite",
      "@id": `${config.siteUrl}/#website`,
      "url": `${config.siteUrl}/`,
      "name": config.name,
      "alternateName": [config.shortName, siteHostname],
      "description": config.description,
      "inLanguage": "en-US",
      "publisher": {
        "@id": `${config.siteUrl}/#organization`
      }
    }] : []),
    {
      "@type": "Organization",
      "@id": `${config.siteUrl}/#organization`,
      "name": config.name,
      "alternateName": config.shortName,
      "url": config.siteUrl,
      "logo": `${config.siteUrl}/images/branding/lirune-icon.png`,
      "sameAs": [
        config.githubRepo,
        config.microsoftStoreUrl
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${config.siteUrl}/#app-windows`,
      "name": "Lirune Reader for Windows",
      "operatingSystem": "Windows 10, Windows 11",
      "applicationCategory": "EBookApplication",
      "softwareVersion": releases.windows.version,
      "datePublished": releases.windows.releaseDate,
      "downloadUrl": releases.windows.installerUrl,
      "license": "https://www.gnu.org/licenses/gpl-3.0.html",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@type": "Person",
        "name": config.author
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${config.siteUrl}/#app-android`,
      "name": "Lirune Reader for Android",
      "operatingSystem": "Android 8.0+",
      "applicationCategory": "EBookApplication",
      "softwareVersion": releases.android.version,
      "datePublished": releases.android.releaseDate,
      "downloadUrl": releases.android.apkUrl,
      "license": "https://www.gnu.org/licenses/gpl-3.0.html",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@type": "Person",
        "name": config.author
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/branding/lirune-icon.png" />
    
    <!-- Theme & System Color Scheme (Prevent FOUT) -->
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0F1217" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F8F8FA" media="(prefers-color-scheme: light)" />

    <ClientRouter />

    <script is:inline>
      function applySavedTheme() {
        try {
          const stored = localStorage.getItem('lirune-theme') || 'system';
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored === 'system' ? (prefersDark ? 'dark' : 'light') : stored;
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-theme-setting', stored);
          document.documentElement.style.colorScheme = theme;
          const themeColor = theme === 'dark' ? '#0F1217' : '#F8F8FA';
          document.querySelectorAll('meta[name="theme-color"]').forEach(m => m.setAttribute('content', themeColor));
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.setAttribute('data-theme-setting', 'system');
          document.documentElement.style.colorScheme = 'dark';
        }
      }
      if (!window.__liruneThemeBound) {
        window.__liruneThemeBound = true;
        document.addEventListener('astro:after-swap', applySavedTheme);
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
            if ((localStorage.getItem('lirune-theme') || 'system') === 'system') applySavedTheme();
          });
        } catch (err) {}
      }
      applySavedTheme();
    </script>

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="application-name" content={config.name} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Lirune Reader" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <SiteHeader currentPath={cleanPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <ScreenshotLightbox />

    <!-- Motion & Interaction Runtime (Scroll Reveals & Stagger) -->
    <script>
      let observer: IntersectionObserver | null = null;

      function revealElement(el: Element) {
        el.classList.add('is-visible');
        if (el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', 'active');
        if (el.classList.contains('stagger-children') || el.hasAttribute('data-stagger')) {
          if (el.hasAttribute('data-stagger')) el.setAttribute('data-stagger', 'active');
          Array.from(el.children).forEach(child => child.classList.add('is-visible'));
        }
      }

      function initMotionSystem() {
        if (observer) {
          observer.disconnect();
          observer = null;
        }
        document.body.style.overflow = '';

        const revealElements = document.querySelectorAll('.reveal, [data-reveal]');
        const staggerContainers = document.querySelectorAll('.stagger-children, [data-stagger]');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealElements.forEach(revealElement);
          staggerContainers.forEach(revealElement);
          return;
        }

        staggerContainers.forEach(container => {
          Array.from(container.children).forEach((child, idx) => {
            (child as HTMLElement).style.setProperty('--stagger-i', String(Math.min(idx, 7)));
          });
        });

        observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              revealElement(entry.target);
              observer?.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.01,
          rootMargin: '0px 0px 40px 0px'
        });

        const viewportBottom = window.innerHeight + 40;
        const targets = new Set([...revealElements, ...staggerContainers]);
        targets.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top <= viewportBottom && rect.bottom >= -100) {
            revealElement(el);
          } else {
            observer?.observe(el);
          }
        });
      }

      document.addEventListener('astro:page-load', initMotionSystem);
      document.addEventListener('astro:before-swap', () => {
        if (observer) {
          observer.disconnect();
          observer = null;
        }
        document.body.style.overflow = '';
      });
    </script>
  </body>
</html>
